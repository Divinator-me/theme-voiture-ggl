{{ 'contact-rc.css' | asset_url | stylesheet_tag }}

<section class="rc-contact-hero" aria-label="Contact RCLAB">
  <span class="rc-contact-hero__glow" aria-hidden="true"></span>
  <span class="rc-contact-hero__stripes" aria-hidden="true"></span>

  <div class="rc-contact-hero__inner">
    <p class="rc-contact-hero__label">Service client RCLAB</p>
    <h1 class="rc-contact-hero__title">
      Une question ?
      <span>On vous répond.</span>
    </h1>
    <p class="rc-contact-hero__lead">
      L'équipe est à Paris. Une question sur une RC, une commande ou une pièce, on te répond sous 1 à 2 jours ouvrés.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Contact header RCLAB",
  "presets": [
    {
      "name": "Contact header RCLAB"
    }
  ]
}
{% endschema %}
