{% assign announcement_items = '🔧 Composants métal · pièces incluses||🇫🇷 SAV français · Lun–Ven 9h–17h||↩️ Retour gratuit · 30 jours||📦 Livraison offerte · 4 à 8 jours ouvrés||🏎️ 290+ références RC' | split: '||' %}

{{ 'announcement-marquee.css' | asset_url | stylesheet_tag }}

<section class="announcement-marquee" aria-label="Informations boutique">
  <div class="announcement-track" aria-hidden="true">
    <div class="announcement-track__inner">
      {% for _loop in (1..2) %}
        {% for item in announcement_items %}
          <span class="announcement-item">{{ item }}</span>
          <span class="announcement-separator"></span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
  <div class="announcement-badge">
    <span class="announcement-badge__dot" aria-hidden="true"></span>
    <span class="announcement-badge__label">INFOS</span>
  </div>
</section>

{% schema %}
{
  "name": "Announcement marquee",
  "presets": [
    {
      "name": "Announcement marquee"
    }
  ]
}
{% endschema %}
