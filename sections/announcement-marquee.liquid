{{ 'announcement-marquee.css' | asset_url | stylesheet_tag }}

<section class="announcement-marquee" aria-label="Informations boutique">
  <div class="announcement-track">
    <div class="announcement-track__inner">
      {% for _loop in (1..2) %}
        <span class="announcement-item announcement-item--with-flag">
          <svg class="announcement-flag" viewBox="0 0 3 2" aria-hidden="true" focusable="false">
            <rect width="1" height="2" fill="#002395"></rect>
            <rect x="1" width="1" height="2" fill="#ffffff"></rect>
            <rect x="2" width="1" height="2" fill="#ed2939"></rect>
          </svg>
          Support client 100% humain français
        </span>
        <span class="announcement-separator"></span>

        <span class="announcement-item">
          <svg class="announcement-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <circle cx="8" cy="5.1" r="2.15" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
            <path d="M3.4 13.1c.7-2.15 2.4-3.25 4.6-3.25s3.9 1.1 4.6 3.25" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
          </svg>
          Besoin d'un conseiller ? Contactez-nous
        </span>
        <span class="announcement-separator"></span>

        <span class="announcement-item">
          <span class="announcement-return" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false">
              <path d="M6.2 3.2 3.2 6.2l3 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M3.6 6.2h6.1a3.1 3.1 0 0 1 0 6.2H8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            </svg>
          </span>
          Retour GRATUIT sous 30 jours
        </span>
        <span class="announcement-separator"></span>

        <span class="announcement-item">
          <svg class="announcement-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path d="M2.2 9.2h9.2l1.5-2.6H6.1L5 5.2H2.2v4z" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
            <circle cx="5.1" cy="11.3" r="1.15" fill="currentColor"></circle>
            <circle cx="11.2" cy="11.3" r="1.15" fill="currentColor"></circle>
          </svg>
          35 références haut de gamme vérifiées
        </span>
        <span class="announcement-separator"></span>
      {% endfor %}
    </div>
  </div>
  <div class="announcement-badge">
    <svg class="announcement-badge__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="6.1" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M8 7.15v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      <circle cx="8" cy="4.7" r="0.8" fill="currentColor"></circle>
    </svg>
    <span class="announcement-badge__label">INFOS</span>
  </div>
</section>

{% schema %}
{
  "name": "Announcement marquee",
  "presets": [
    {
      "name": "Announcement marquee"
    }
  ]
}
{% endschema %}
