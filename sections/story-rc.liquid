{{ 'story-rc.css' | asset_url | stylesheet_tag }}
{{ 'quiz-cta.css' | asset_url | stylesheet_tag }}

<section class="rc-story" aria-label="Notre histoire">
  <div class="rc-story__inner">
    <figure class="rc-story__media">
      <img
        src="{{ 'story-team.png' | asset_url }}"
        alt="L'équipe RCLAB sur un circuit de voitures RC"
        width="1376"
        height="768"
        loading="lazy"
      >
    </figure>

    <p class="rc-story__eyebrow">L'équipe RCLAB</p>
    <h2 class="rc-story__title">On a monté la marque qu'on aurait voulu trouver.</h2>
    <p class="rc-story__text">
      À l'origine de RCLAB, une bande de mecs qui bidouillent des RC depuis qu'ils ont dix ans. On en a cassé, réparé, upgradé, revendu, racheté. On en connaît les défauts par cœur, et c'est pour ça qu'on sélectionne nos partenaires un par un, plutôt que de fabriquer nous-mêmes. Pas de call center à l'autre bout du monde : quand tu nous écris, c'est un passionné qui te répond, avec sa RC posée sur le bureau.
    </p>

    {% unless template.name == 'product' %}
      <button type="button" class="rc-quiz-cta__button rc-story__quiz" data-rc-quiz-open>
        <span class="rc-quiz-cta__label">
          <span class="rc-quiz-cta__title">
            Trouver ma voiture RC<span class="rc-quiz-cta__arrow" aria-hidden="true"> →</span>
          </span>
          <span class="rc-quiz-cta__note">Un quiz personnalisé de 12 secondes pour trouver ta gamme RC</span>
        </span>
      </button>
    {% endunless %}
  </div>
</section>

{% schema %}
{
  "name": "Story RC",
  "presets": [
    {
      "name": "Story RC"
    }
  ]
}
{% endschema %}
