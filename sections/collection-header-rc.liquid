{{ 'collection-rc.css' | asset_url | stylesheet_tag }}

<section class="rc-collection-header" aria-label="{{ collection.title | escape }}">
  <div class="rc-collection-header__inner">
    <div class="rc-collection-header__top">
      <p class="rc-collection-header__eyebrow">Catalogue RC LAB</p>
      <p class="rc-collection-header__count">
        <span>{{ collection.products_count }}</span>
        {% if collection.products_count > 1 %}articles{% else %}article{% endif %}
      </p>
    </div>

    <h1 class="rc-collection-header__title">{{ collection.title }}</h1>

    {% if collection.description != blank %}
      <div class="rc-collection-header__desc">{{ collection.description }}</div>
    {% endif %}
  </div>

  <div class="rc-collection-header__accent" aria-hidden="true"></div>
</section>

{% schema %}
{
  "name": "En-tête collection RC",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [],
  "presets": [
    {
      "name": "En-tête collection RC"
    }
  ]
}
{% endschema %}
