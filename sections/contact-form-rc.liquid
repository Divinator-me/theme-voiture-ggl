{{ 'contact-rc.css' | asset_url | stylesheet_tag }}

{% liquid
  assign form_id = 'ContactForm-rc'
  assign legal_mentions_url = '/policies/legal-notice'
  assign legal_cgv_url = '/policies/terms-of-sale'
  for shop_policy in shop.policies
    if shop_policy.url contains 'legal-notice'
      assign legal_mentions_url = shop_policy.url
    endif
    if shop_policy.url contains 'terms-of-sale'
      assign legal_cgv_url = shop_policy.url
    endif
  endfor
%}

<section class="rc-contact-board" aria-label="Formulaire de contact">
  <div class="rc-contact-board__inner">
    <div class="rc-contact-panel">
      <header class="rc-contact-panel__header">
        <h2>Formulaire de contact</h2>
        <p>Plus tu es précis, plus notre réponse sera utile.</p>
      </header>

      {%- form 'contact', id: form_id, class: 'rc-contact-form' -%}
        <input name="contact[id]" type="hidden" value="{{ form_id }}">

        {% liquid
          assign form_matches = false
          if form.id == form_id or form.id == blank
            assign form_matches = true
          endif
        %}

        {%- if form.errors and form_matches -%}
          <div class="rc-contact-form__status rc-contact-form__status--error" tabindex="-1" autofocus>
            L'email n'est pas valide. Vérifie-le et renvoie ta demande.
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? and form_matches -%}
          <div class="rc-contact-form__status rc-contact-form__status--success" tabindex="-1" autofocus>
            Message bien reçu. On te répond sous 24 à 48 heures.
          </div>
        {%- endif -%}

        <div class="rc-contact-form__grid">
          <label class="rc-contact-field">
            <span>Nom</span>
            <input
              type="text"
              name="contact[name]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              placeholder="Ton nom"
            >
          </label>

          <label class="rc-contact-field">
            <span>E-mail *</span>
            <input
              type="email"
              name="contact[email]"
              autocomplete="email"
              spellcheck="false"
              autocapitalize="off"
              required
              aria-required="true"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              placeholder="toi@exemple.fr"
            >
          </label>

          <label class="rc-contact-field">
            <span>Téléphone</span>
            <input
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
              placeholder="Facultatif"
            >
          </label>

          <label class="rc-contact-field">
            <span>Numéro de commande</span>
            <input
              type="text"
              name="contact[Numéro de commande]"
              placeholder="#1234"
            >
          </label>
        </div>

        <label class="rc-contact-field">
          <span>Sujet</span>
          <select name="contact[Sujet]">
            <option value="Une question avant d'acheter" selected>Une question avant d'acheter</option>
            <option value="Suivi de commande">Suivi de commande</option>
            <option value="SAV / pièce">SAV / pièce</option>
            <option value="Retour">Retour</option>
            <option value="Autre">Autre</option>
          </select>
        </label>

        <label class="rc-contact-field">
          <span>Ton message *</span>
          <textarea
            name="contact[body]"
            rows="7"
            required
            aria-required="true"
            placeholder="Décris ta demande. Si tu as des photos, envoie-les aussi à support@rclab-car.com."
          >{{- form.body -}}</textarea>
        </label>

        <div class="rc-contact-form__footer">
          <button type="submit" class="rc-contact-form__submit">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3.4 20.6 21 12 3.4 3.4l2.1 7.4L14 12l-8.5 1.2Z" fill="currentColor"/>
            </svg>
            <span>Envoyer</span>
          </button>
          <p>Tes infos servent uniquement à traiter ta demande.</p>
        </div>
      {%- endform -%}
    </div>

    <aside class="rc-contact-aside">
      <a class="rc-contact-card" href="mailto:support@rclab-car.com">
        <span class="rc-contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="m4 7 8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="rc-contact-card__copy">
          <span class="rc-contact-card__label">E-mail</span>
          <strong>support@rclab-car.com</strong>
          <span>Le canal le plus simple pour le SAV et les pièces.</span>
        </span>
      </a>

      <a class="rc-contact-card" href="tel:+33756884492">
        <span class="rc-contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M7.2 3.8h3.1l1.2 3.4-1.9 1.2a12.6 12.6 0 0 0 5 5l1.2-1.9 3.4 1.2v3.1c0 .8-.6 1.5-1.4 1.6-7.3.9-13.4-5.2-12.5-12.5.1-.8.8-1.4 1.6-1.4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="rc-contact-card__copy">
          <span class="rc-contact-card__label">Téléphone</span>
          <strong>+33 7 56 88 44 92</strong>
          <span>Du lundi au vendredi, 9h à 17h.</span>
        </span>
      </a>

      <div class="rc-contact-card">
        <span class="rc-contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
            <path d="M12 7.5V12l3.2 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="rc-contact-card__copy">
          <span class="rc-contact-card__label">Horaires</span>
          <strong>Lun au ven, 9h à 17h</strong>
          <span>Fermé le week-end et les jours fériés.</span>
        </span>
      </div>

      <a class="rc-contact-card" href="https://www.google.com/maps/search/?api=1&query=47+rue+Vivienne,+75002+Paris,+France" target="_blank" rel="noopener noreferrer">
        <span class="rc-contact-card__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M12 21s6.5-6.1 6.5-11A6.5 6.5 0 0 0 5.5 10c0 4.9 6.5 11 6.5 11Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
            <circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
          </svg>
        </span>
        <span class="rc-contact-card__copy">
          <span class="rc-contact-card__label">Adresse</span>
          <strong>47 rue Vivienne, 75002 Paris</strong>
          <span>France</span>
        </span>
      </a>

      <div class="rc-contact-response">
        <span class="rc-contact-response__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24">
            <path d="M3.4 20.6 21 12 3.4 3.4l2.1 7.4L14 12l-8.5 1.2Z" fill="currentColor"/>
          </svg>
        </span>
        <span>
          <strong>Réponse sous 24 à 48 heures</strong>
          <span>Jours ouvrés. Chaque message reçoit une réponse.</span>
        </span>
      </div>

      <p class="rc-contact-aside__legal">
        <span>Société : RCLAB, éditeur du site rclab-car.com</span>
        <span>Informations : <a class="rc-contact-aside__link" href="{{ legal_mentions_url }}">mentions légales</a> et <a class="rc-contact-aside__link" href="{{ legal_cgv_url }}">conditions générales</a> en bas de page.</span>
      </p>
    </aside>
  </div>
</section>

{% schema %}
{
  "name": "Formulaire contact RCLAB",
  "presets": [
    {
      "name": "Formulaire contact RCLAB"
    }
  ]
}
{% endschema %}
