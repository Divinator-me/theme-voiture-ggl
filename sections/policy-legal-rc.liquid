{%- comment -%} Politiques légales RCLAB — /policies/* (Shopify) + pages custom {%- endcomment -%}
{{ 'policy-rc.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rc_policy_key = ''

  if policy != blank
    if shop.refund_policy != blank and policy.id == shop.refund_policy.id
      assign rc_policy_key = 'retours'
    elsif shop.shipping_policy != blank and policy.id == shop.shipping_policy.id
      assign rc_policy_key = 'livraison'
    elsif shop.privacy_policy != blank and policy.id == shop.privacy_policy.id
      assign rc_policy_key = 'confidentialite'
    endif
  endif

  if rc_policy_key == blank
    assign rc_policy_slug = request.path | split: '/policies/' | last | split: '?' | first

    case rc_policy_slug
      when 'refund-policy'
        assign rc_policy_key = 'retours'
      when 'shipping-policy'
        assign rc_policy_key = 'livraison'
      when 'privacy-policy'
        assign rc_policy_key = 'confidentialite'
    endcase
  endif

  if rc_policy_key == blank
    case template.suffix
      when 'conditions-paiement'
        assign rc_policy_key = 'paiement'
      when 'conditions-generales-de-vente', 'conditions-de-vente'
        assign rc_policy_key = 'cgv'
      when 'faq-boutique'
        assign rc_policy_key = 'faq-boutique'
    endcase
  endif

  case rc_policy_key
    when 'retours'
      assign legal_title = 'Politique de retour et remboursement'
      assign legal_badge = 'Informations légales'
    when 'livraison'
      assign legal_title = 'Politique de livraison'
      assign legal_badge = 'Informations légales'
    when 'confidentialite'
      assign legal_title = 'Politique de confidentialité'
      assign legal_badge = 'Informations légales'
    when 'cgv'
      assign legal_title = 'Conditions générales de vente'
      assign legal_badge = 'Informations légales'
    when 'paiement'
      assign legal_title = 'Conditions de facturation et de paiement'
      assign legal_badge = 'Informations légales'
    when 'faq-boutique'
      assign legal_title = 'FAQ boutique'
      assign legal_badge = 'Aide'
    else
      assign legal_title = policy.title | default: page.title
      assign legal_badge = 'Informations légales'
  endcase
-%}

<section class="rc-policy" aria-label="{{ legal_title | escape }}">
  <div class="rc-policy__inner">
    <header class="rc-policy__header">
      <span class="rc-policy__badge">{{ legal_badge }}</span>
      <h1>{{ legal_title }}</h1>
    </header>

    <div class="rc-policy__content rte">
      {% case rc_policy_key %}
        {% when 'retours' %}
          {% render 'policy-refund-rc' %}
        {% when 'livraison' %}
          {% render 'policy-shipping-rc' %}
        {% when 'confidentialite' %}
          {% render 'policy-privacy-rc' %}
        {% when 'cgv' %}
          {% render 'policy-terms-rc' %}
        {% when 'paiement' %}
          {% render 'policy-billing-rc' %}
        {% when 'faq-boutique' %}
          {% render 'policy-faq-gmc-rc' %}
        {% else %}
          {% if policy.body != blank %}
            {{ policy.body }}
          {% else %}
            {{ page.content }}
          {% endif %}
      {% endcase %}

      {% render 'policy-contact-rc' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Politique légale RCLAB",
  "presets": [
    {
      "name": "Politique légale RCLAB"
    }
  ]
}
{% endschema %}
