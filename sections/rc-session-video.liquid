{%- liquid
  assign session_product = product | default: closest.product
  assign session_handle = session_product.handle | default: ''
  assign session_set = ''
  assign session_hay = session_handle | append: ' ' | append: session_product.title | downcase
  if session_handle == 'sweep-pro-4x4-voiture-telecommandee-tout-terrain-70-km-h' or session_handle == 'sweep-pro-4x4-70-kmh-rclab'
    assign session_set = 'sweep'
  elsif session_handle == 'conquer-4x4-1-16-voiture-telecommandee-tout-terrain-50-km-h' or session_handle == '4x4-tout-terrain-1-16-50-km-h' or session_hay contains 'conquer'
    assign session_set = 'conquer'
  elsif session_handle == 'lancia-delta-martini-racing-1-14-voiture-telecommandee-de-rallye-et-drift' or session_handle == 'lancia-delta-martini-1-14-rc-rclab' or session_hay contains 'lancia'
    assign session_set = 'lancia'
  elsif session_handle == 'nissan-gt-r-nismo-gt500-1-24-voiture-telecommandee-drift-et-piste' or session_hay contains 'gt500'
    assign session_set = 'nismo'
  elsif session_handle == '4x4-rc-1-16-brushless-70-kmh-rclab' or session_handle == '4x4-off-road-1-16-voiture-telecommandee-brushless-70-km-h' or session_hay contains 'gantry'
    assign session_set = 'gantry'
  elsif session_handle == 'force-13-buggy-4x4-75-kmh-rclab' or session_handle == 'force-13-1-12-buggy-telecommande-4x4-haute-vitesse-75-km-h' or session_hay contains 'force-13' or session_hay contains 'format 45'
    assign session_set = 'force13'
  endif
-%}

{{ 'rc-session-video.css' | asset_url | stylesheet_tag }}

<section class="rc-session{% if session_set == blank %} rc-session--specs-only{% endif %}" aria-label="{% if session_set == 'sweep' %}Session Sweep Pro{% elsif session_set == 'conquer' %}Session Conquer{% elsif session_set == 'lancia' %}Session Lancia Delta{% elsif session_set == 'nismo' %}Session GT-R NISMO{% elsif session_set == 'gantry' %}Session Gantry Pro{% elsif session_set == 'force13' %}Session buggy 1/12{% else %}Caractéristiques{% endif %}">
  {%- if session_set == 'sweep' -%}
    <div class="rc-session__inner">
      <div class="rc-session__copy">
        <p class="rc-session__lead">Une session complète avec</p>
        <h2 class="rc-session__title">la Sweep Pro RCLAB</h2>
        <p class="rc-session__tags">Déballage, essai, vitesse, adrénaline, saut, crash. Et elle encaisse. Saltos et figures jusqu'à la fin de la session.</p>
      </div>

      <div class="rc-session__media">
        <video
          class="rc-session__video"
          poster="{{ 'rc-session-sweep-poster.jpg' | asset_url }}"
          src="https://cdn.shopify.com/videos/c/o/v/ebbe3cc84961408ebed61f9dabdd2a53.mp4"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          controls
          preload="auto"
        ></video>
      </div>
    </div>
  {%- elsif session_set == 'conquer' -%}
    <div class="rc-session__inner">
      <div class="rc-session__copy">
        <p class="rc-session__lead">Une session complète avec</p>
        <h2 class="rc-session__title">le Conquer RCLAB</h2>
        <p class="rc-session__tags">Déballage, tout-terrain, 50 km/h. Elle passe l'herbe, la terre et les bosses.</p>
      </div>

      <div class="rc-session__media">
        <video
          class="rc-session__video"
          poster="{{ 'rc-session-conquer-poster.jpg' | asset_url }}"
          src="https://cdn.shopify.com/videos/c/o/v/7484d718a89147feb2e9421819f6e156.mp4"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          controls
          preload="auto"
        ></video>
      </div>
    </div>
  {%- elsif session_set == 'lancia' -%}
    <div class="rc-session__inner">
      <div class="rc-session__copy">
        <p class="rc-session__lead">Une session complète avec</p>
        <h2 class="rc-session__title">la Lancia Delta RCLAB</h2>
        <p class="rc-session__tags">Drift, rallye, 1/14. Les lignes Martini, la glisse, la piste.</p>
      </div>

      <div class="rc-session__media">
        <video
          class="rc-session__video"
          poster="{{ 'rc-session-lancia-poster.jpg' | asset_url }}"
          src="https://cdn.shopify.com/videos/c/o/v/a9c9905c44c449a7b4fb7b32d5108137.mp4"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          controls
          preload="auto"
        ></video>
      </div>
    </div>
  {%- elsif session_set == 'nismo' -%}
    <div class="rc-session__inner">
      <div class="rc-session__copy">
        <p class="rc-session__lead">Une session complète avec</p>
        <h2 class="rc-session__title">la GT-R NISMO GT500</h2>
        <p class="rc-session__tags">Déballage, drift, piste. Deux trains de pneus, les néons, 30 km/h.</p>
      </div>

      <div class="rc-session__media">
        <video
          class="rc-session__video"
          poster="{{ 'rc-session-nismo-poster.jpg' | asset_url }}"
          src="https://cdn.shopify.com/videos/c/o/v/2cd6bde461404b3ea6cd1b83db51da0c.mp4"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          controls
          preload="auto"
        ></video>
      </div>
    </div>
  {%- elsif session_set == 'gantry' -%}
    <div class="rc-session__inner">
      <div class="rc-session__copy">
        <p class="rc-session__lead">Une session complète avec</p>
        <h2 class="rc-session__title">le Gantry Pro</h2>
        <p class="rc-session__tags">Tout-terrain, brushless, 70 km/h. Terre, eau, bosses. Elle encaisse.</p>
      </div>

      <div class="rc-session__media">
        <iframe
          class="rc-session__yt"
          src="https://www.youtube-nocookie.com/embed/V1SJu7ya7Ts?rel=0&modestbranding=1&playsinline=1"
          title="Session Gantry Pro"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  {%- elsif session_set == 'force13' -%}
    <div class="rc-session__inner">
      <div class="rc-session__copy">
        <p class="rc-session__lead">Une session complète avec</p>
        <h2 class="rc-session__title">le buggy 1/12</h2>
        <p class="rc-session__tags">45 cm, brushless, 75 km/h. Test vitesse 3S.</p>
      </div>

      <div class="rc-session__media">
        <video
          class="rc-session__video"
          poster="{{ 'rc-session-force13-poster.jpg' | asset_url }}"
          src="https://cdn.shopify.com/videos/c/o/v/888d104ca31d4a58b1135edec6b7a9eb.mp4"
          autoplay
          muted
          loop
          playsinline
          webkit-playsinline
          controls
          preload="auto"
        ></video>
      </div>
    </div>
  {%- endif -%}

  <div class="rc-session__specs rc-product-desc__content rte" data-rc-session-specs></div>
</section>

{% schema %}
{
  "name": "Session vidéo RC",
  "presets": [
    {
      "name": "Session vidéo RC"
    }
  ]
}
{% endschema %}
