{{ 'rc-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rc-product-card.js' | asset_url }}" defer></script>
{{ 'best-sellers.css' | asset_url | stylesheet_tag }}
<script src="{{ 'rc-drag-scroll.js' | asset_url }}" defer></script>
<script src="{{ 'rc-product-recommendations.js' | asset_url }}" defer></script>

{% liquid
  assign current_product = section.settings.product | default: product
  assign heading = section.settings.title
  if heading == blank
    assign heading = 'Produits similaires'
  endif

  assign nav_handles = 'monster-truck-4x4,buggy,rallye-trophy,drift,piste' | split: ','
  assign source_collection = collections['monster-truck-4x4']
  assign found_nav = false

  if current_product != blank
    for handle in nav_handles
      unless found_nav
        for col in current_product.collections
          if col.handle == handle
            assign source_collection = col
            assign found_nav = true
            break
          endif
        endfor
      endunless
    endfor
  endif

  assign ranked_products = nil
  if source_collection != blank and source_collection.products_count > 0
    assign ranked_products = source_collection.products | sort: 'price' | reverse
  elsif recommendations.performed and recommendations.products_count > 0
    assign ranked_products = recommendations.products | sort: 'price' | reverse
  endif

  assign has_ranked = false
  if ranked_products != blank
    assign has_ranked = true
  endif
%}

<rc-product-recommendations
  class="rc-best-sellers rc-product-recommendations{% unless has_ranked %} is-loading{% endunless %}"
  id="rc-product-recommendations-{{ section.id }}"
  data-rc-product-slider
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ current_product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-recommendations-performed="{% if has_ranked %}true{% else %}{{ recommendations.performed }}{% endif %}"
  aria-label="{{ heading | escape }}"
  {{ section.shopify_attributes }}
>
  <div class="rc-best-sellers__header">
    <h2>{{ heading }}</h2>
  </div>

  <div class="rc-best-sellers__shell">
    <button class="rc-best-sellers__arrow rc-best-sellers__arrow--prev" type="button" data-slider-prev aria-label="Produits précédents">
      <svg class="rc-best-sellers__arrow-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <div class="rc-best-sellers__track" data-slider-track tabindex="0" aria-label="{{ heading | escape }}">
      {% if has_ranked %}
        {% assign rendered_count = 0 %}
        {% for item in ranked_products %}
          {% if current_product != blank and item.id == current_product.id %}
            {% continue %}
          {% endif %}
          {% render 'rc-product-card', product: item %}
          {% assign rendered_count = rendered_count | plus: 1 %}
          {% if rendered_count >= section.settings.max_products %}
            {% break %}
          {% endif %}
        {% endfor %}
      {% else %}
        {% for index in (1..4) %}
          <article class="rc-product-card rc-product-recommendations__skeleton" aria-hidden="true">
            <div class="rc-product-card__media">
              <div class="rc-product-card__image-wrap">
                <div class="rc-product-card__image"></div>
              </div>
            </div>
            <div class="rc-product-card__body">
              <h3>&nbsp;</h3>
              <p class="rc-product-card__price">&nbsp;</p>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>

    <button class="rc-best-sellers__arrow rc-best-sellers__arrow--next" type="button" data-slider-next aria-label="Produits suivants">
      <svg class="rc-best-sellers__arrow-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
        <path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
</rc-product-recommendations>

{% schema %}
{
  "name": "Recommandations RC",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre de section",
      "default": "Nos monster truck"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Type",
      "options": [
        { "value": "related", "label": "Produits similaires" },
        { "value": "complementary", "label": "Produits complémentaires" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Nombre de produits",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Recommandations RC"
    }
  ]
}
{% endschema %}
