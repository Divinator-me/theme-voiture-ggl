{{ 'collection-guide-rc.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign handle = collection.handle
  assign guide_title = 'Bien choisir sa RC'
  assign photo = 'rc-guide-default-1.webp'
  assign photo_alt = "Atelier RC LAB, châssis en cours de réglage"

  case handle
    when 'monster-truck-4x4'
      assign guide_title = 'Bien choisir son monster truck'
      assign photo = 'rc-guide-monster-1.webp'
      assign photo_alt = 'Monster truck RC en saut sur rampe'
    when 'buggy'
      assign guide_title = 'Bien choisir son buggy'
      assign photo = 'rc-guide-buggy-1.webp'
      assign photo_alt = "Montage d'un buggy RC sur le sol de l'atelier"
    when 'rallye-trophy'
      assign guide_title = 'Bien choisir son rallye'
      assign photo = 'rc-guide-rallye-1.webp'
      assign photo_alt = 'Session outdoor rallye trophy RC'
    when 'drift'
      assign guide_title = 'Bien choisir son drift'
      assign photo = 'rc-guide-drift-1.webp'
      assign photo_alt = 'Voiture RC drift en intérieur'
    when 'piste'
      assign guide_title = 'Bien choisir sa piste'
      assign photo = 'rc-guide-piste-1.webp'
      assign photo_alt = 'Pilotes RC sur un circuit'
    when 'crawler'
      assign guide_title = 'Bien choisir son crawler'
      assign photo = 'rc-guide-crawler-1.webp'
      assign photo_alt = 'Crawler RC encore boueux après un passage en forêt'
  endcase
-%}

<section class="rc-guide" aria-label="{{ guide_title | escape }}">
  <span class="rc-guide__glow" aria-hidden="true"></span>

  <div class="rc-guide__inner">
    <div class="rc-guide__choose">
      <h2 class="rc-guide__label">{{ guide_title }}</h2>

      {% case handle %}
        {% when 'monster-truck-4x4' %}
          <article>
            <h3>4x4, c'est le grip</h3>
            <p>Quatre roues motrices, ça tient dans l'herbe, la terre et les montées. C'est pour ça que cette collection existe : des 4x4 calibrés pour sortir, pas pour rester sur le bitume.</p>
          </article>
          <article>
            <h3>La vitesse, tu la choisis</h3>
            <p>La gamme monte jusqu'à 85 km/h en brushless. Plus c'est rapide, plus la session a de la gueule dès que tu as de l'espace. Chaque fiche indique la pointe, tu prends celle qui te fait plaisir.</p>
          </article>
          <article>
            <h3>Brushless, le palier qui compte</h3>
            <p>Plus de couple, une voiture qui reste nerveuse session après session. Sur nos 4x4 les plus rapides, c'est ce moteur qui fait la différence dans le temps.</p>
          </article>
          <article>
            <h3>Le terrain réel</h3>
            <p>Jardin, chemin, parking cabossé, boue, cailloux. Ces 4x4 sont pensés pour ça. Tu regardes où tu vas rouler, tu prends le modèle au-dessus. 2 batteries offertes, tu sors le jour même.</p>
          </article>

        {% when 'buggy' %}
          <article>
            <h3>Léger, rapide, joueur</h3>
            <p>Un buggy change de direction plus vite qu'un monster truck. C'est la collection si tu veux une RC vive, sur terre, qui réagit au doigt.</p>
          </article>
          <article>
            <h3>Terre et herbe rase</h3>
            <p>Champ, jardin ouvert, piste terre. C'est leur terrain. On les a choisies pour ça : tu sors, tu traces, tu rentres avec de la poussière sur le châssis.</p>
          </article>
          <article>
            <h3>L'échelle, selon l'espace</h3>
            <p>Un 1/16 part dans un sac. Un 1/10 a plus de présence et demande de la place pour utiliser la vitesse. Les deux sont dans la grille, à toi de voir où tu roules.</p>
          </article>
          <article>
            <h3>Brushless pour enchaîner</h3>
            <p>Nos buggys les plus rapides tiennent 70 à 75 km/h. Le brushless garde le punch quand tu enchaînes les sessions. 2 batteries offertes, tu allonges avec les packs sur la fiche.</p>
          </article>

        {% when 'rallye-trophy' %}
          <article>
            <h3>Toutes surfaces</h3>
            <p>Terre, gravier, un peu de bitume. Le rallye RC, c'est la voiture qui n'est pas coincée à un seul sol. Cette collection est là pour ça.</p>
          </article>
          <article>
            <h3>Réplique qui roule</h3>
            <p>Une C3 WRC, ça a une gueule. Un trophy passe plus de bosses. Les deux sont dans la gamme : tu achètes le look, tu sors quand même.</p>
          </article>
          <article>
            <h3>Pas seulement le parking</h3>
            <p>Si tu veux une auto qui ressemble à quelque chose et qui tient un mix de terrains, tu es au bon endroit. Les modèles au-dessus sont prêts à partir.</p>
          </article>
          <article>
            <h3>Session dans la boîte</h3>
            <p>2 batteries offertes sur chaque véhicule. Tu charges, tu sors. Les batteries en plus, c'est pour tenir l'après-midi sans regarder la prise.</p>
          </article>

        {% when 'drift' %}
          <article>
            <h3>Le glissé, c'est le programme</h3>
            <p>Angle, trajectoire, contrôle. Nos drifts sont montées pour ça, pneus compris. Tu n'achètes pas une ligne droite, tu achètes le slide.</p>
          </article>
          <article>
            <h3>Sol lisse, ça glisse</h3>
            <p>Carrelage, parking, garage. C'est là qu'elles donnent. Plusieurs échelles dans la collection, du salon au parking.</p>
          </article>
          <article>
            <h3>Indoor ou extérieur</h3>
            <p>Un 1/24 se sort entre quatre murs. Les plus grandes veulent un sol dur un peu plus ouvert. Tu prends selon la place que tu as, les deux profils sont là.</p>
          </article>
          <article>
            <h3>Prêt à glisser</h3>
            <p>Rien à monter pour commencer. Jusqu'à 65 km/h selon le modèle. 2 batteries offertes, tu enchaînes les runs dès la première charge.</p>
          </article>

        {% when 'piste' %}
          <article>
            <h3>Précision sur sol lisse</h3>
            <p>Basse, nerveuse, faite pour l'asphalte, le carrelage, un tracé. C'est une autre façon de piloter, et cette collection est calibrée pour ça.</p>
          </article>
          <article>
            <h3>Le sol décide</h3>
            <p>Parking, piste intérieure, sol dur. Si tu as ça, une voiture de piste a tout son sens. Le grip vient du sol, les modèles au-dessus en profitent.</p>
          </article>
          <article>
            <h3>L'échelle, selon la place</h3>
            <p>Les 1/24 se sortent dans un salon. Les plus grandes demandent un vrai tracé. On a les deux formats, tu prends celui qui rentre dans ton usage.</p>
          </article>
          <article>
            <h3>Trajectoire et frein</h3>
            <p>Tu places la voiture, tu apprends la ligne. Beaucoup gardent une piste et un 4x4 : ce n'est pas le même plaisir. 2 batteries offertes, tu roules tout de suite.</p>
          </article>

        {% when 'crawler' %}
          <article>
            <h3>Le couple, pas la pointe</h3>
            <p>Un crawler grimpe, s'arrête en pente, cherche la ligne. C'est un autre jeu, et nos modèles sont choisis pour ça : démultiplication, motricité, passage.</p>
          </article>
          <article>
            <h3>Roches, racines, pentes</h3>
            <p>Jardin accidenté, tas de bois, petit sentier. C'est là qu'un crawler montre ce qu'il fait. Tu as ce terrain, tu as ta collection.</p>
          </article>
          <article>
            <h3>La config qui grimpe</h3>
            <p>Double moteur, réplique 1/12, 4x4 lent et costaud. Les fiches au-dessus détaillent chaque montage. Tu prends celle qui correspond à tes obstacles.</p>
          </article>
          <article>
            <h3>Des sessions qui durent</h3>
            <p>Tu roules doucement, les packs tiennent. 2 batteries offertes, tu as de quoi enchaîner les passages sans rentrer au bout de dix minutes.</p>
          </article>

        {% else %}
          <article>
            <h3>Le terrain d'abord</h3>
            <p>Jardin, terre, parking, salon. Chaque gamme RC LAB est faite pour un usage. Tu choisis le sol, tu tombes sur les modèles qui vont avec.</p>
          </article>
          <article>
            <h3>La vitesse, selon l'envie</h3>
            <p>La boutique va loin, jusqu'aux brushless les plus rapides. Tu prends la pointe qui te fait kiffer, la fiche l'affiche clairement.</p>
          </article>
          <article>
            <h3>Brushed ou brushless</h3>
            <p>Brushed pour un usage simple et costaud. Brushless pour le punch qui tient dans le temps. Les deux sont dans le catalogue, tu montes le curseur si tu veux.</p>
          </article>
          <article>
            <h3>Deux batteries, déjà dans la boîte</h3>
            <p>Chaque véhicule part avec 2 batteries offertes. Pack duo et trio si tu veux plus de roulage. Les supplémentaires se rajoutent sur la fiche.</p>
          </article>
      {% endcase %}
    </div>

    <div class="rc-guide__side">
      <div class="rc-guide-faq">
        <h2>Questions fréquentes</h2>

        <div class="rc-guide-faq__list">
          {% case handle %}
            {% when 'monster-truck-4x4' %}
              {% render 'rc-guide-faq-item', question: "Elle passe vraiment dans l'herbe et la terre ?", answer: "Oui. 4 roues motrices, suspensions indépendantes, c'est le terrain de cette collection. Tu prends un 4x4 pour ça, pas pour le salon." %}
              {% render 'rc-guide-faq-item', question: "Je vise quelle vitesse ?", answer: "Regarde la fiche. La gamme monte jusqu'à 85 km/h en brushless. Plus tu as d'espace, plus tu profites de la pointe. Les modèles sont prêts, batteries incluses." %}
              {% render 'rc-guide-faq-item', question: "Combien de batteries pour une après-midi ?", answer: "2 batteries offertes. Compte 25 minutes en moyenne par pack, ça dépend du modèle et de la batterie. Avec des batteries en plus, tu changes direct sur le terrain et tu continues à jouer, sans rentrer charger." %}
              {% render 'rc-guide-faq-item', question: "Je dois tout démonter pour l'entretien ?", answer: "Non. Un chiffon, un coup d'œil aux vis, et le SAV France si un truc cloche. Photo ou vidéo, on t'oriente. Tu achètes, tu sors." %}

            {% when 'buggy' %}
              {% render 'rc-guide-faq-item', question: "Un buggy ou un 4x4 ?", answer: "Buggy si tu veux de l'agilité sur terre. 4x4 si tu veux encaisser plus gros. Cette collection, c'est le vif. Les modèles au-dessus sont choisis pour ça." %}
              {% render 'rc-guide-faq-item', question: "Jardin, ça suffit ?", answer: "Oui s'il est un peu ouvert. Un 1/10 brushless demande plus d'espace pour utiliser la vitesse. C'est pour ça qu'on a plusieurs échelles dans la grille." %}
              {% render 'rc-guide-faq-item', question: "Je prends brushless tout de suite ?", answer: "Si tu veux la puissance dès le premier week-end, oui. Les buggys brushless de la collection gardent le punch sur la durée." %}
              {% render 'rc-guide-faq-item', question: "Ça passe dans la boue ?", answer: "Boue légère, oui. Grosses flaques, non. Après la session, un coup de chiffon et au sec. Elles sont faites pour sortir, pas pour rester en carton." %}

            {% when 'rallye-trophy' %}
              {% render 'rc-guide-faq-item', question: "C'est du tout-terrain ou du bitume ?", answer: "Les deux, c'est le principe. Mix terre et route. Pour du drift pur, va sur Drift. Ici tu gardes une auto qui avance partout." %}
              {% render 'rc-guide-faq-item', question: "La réplique tient les chocs ?", answer: "La carrosserie prend, comme une vraie. Le châssis est dimensionné pour rouler, pas pour rester en vitrine. Tu l'achètes pour t'en servir." %}
              {% render 'rc-guide-faq-item', question: "Ça marche pour un premier achat ?", answer: "Oui si tu veux une auto qui a une gueule dès la première sortie. Les modèles au-dessus partent avec 2 batteries, tu roules tout de suite." %}
              {% render 'rc-guide-faq-item', question: "Quelle autonomie ?", answer: "25 minutes en moyenne par batterie, ça dépend du modèle et du pack. 2 offertes, tu enchaînes. Les supplémentaires, tu les changes sur place et l'après-midi continue." %}

            {% when 'drift' %}
              {% render 'rc-guide-faq-item', question: "Je peux drifter au garage ?", answer: "Sol dur, carrelage, parking : oui. Surtout en 1/24 à l'intérieur. Moquette, ça ne glisse pas. Tu prends le format selon la pièce que tu as." %}
              {% render 'rc-guide-faq-item', question: "Il faut des pneus en plus ?", answer: "Non. Elles partent avec des pneus drift. Tu ouvres, tu charges, tu glisses." %}
              {% render 'rc-guide-faq-item', question: "C'est accessible dès la première session ?", answer: "Les premières minutes, ça part. Après un pack, tu commences à tenir l'angle. Les modèles sont prêts, rien à régler pour commencer." %}
              {% render 'rc-guide-faq-item', question: "Ça va jusqu'où en vitesse ?", answer: "Jusqu'à 65 km/h selon le modèle. Assez pour un vrai drift, pas un glissement de salonnette. 2 batteries offertes pour enchaîner les runs." %}

            {% when 'piste' %}
              {% render 'rc-guide-faq-item', question: "Elle roule dans l'herbe ?", answer: "Non. Sol dur uniquement. Pour le jardin, prends un buggy ou un 4x4. Ici tu achètes la précision sur asphalte ou carrelage." %}
              {% render 'rc-guide-faq-item', question: "Intérieur ou parking ?", answer: "Les petites échelles se sortent au salon. Les plus grandes veulent un tracé. L'échelle est sur la fiche, tu prends celle qui rentre chez toi." %}
              {% render 'rc-guide-faq-item', question: "Moins spectaculaire qu'un 4x4 ?", answer: "Autre spectacle. Tu pilotes la ligne. Beaucoup gardent une piste et un 4x4, ce n'est pas le même usage. Les deux collections sont là." %}
              {% render 'rc-guide-faq-item', question: "Ça casse au premier mur ?", answer: "Tu vises moins les murs, c'est le jeu. Un choc de parking reste gérable. Le châssis est fait pour courir, 2 batteries incluses pour enchaîner." %}

            {% when 'crawler' %}
              {% render 'rc-guide-faq-item', question: "C'est lent, ça a un intérêt ?", answer: "Oui : le passage, la grimpe, la ligne. La vitesse, c'est une autre collection. Ici tu achètes le crawler pour ce qu'il fait mieux que les autres." %}
              {% render 'rc-guide-faq-item', question: "Quel terrain minimum ?", answer: "Racines, muret, tas de bois, jardin accidenté. Un salon plat, non. Si tu as du relief, tu as ta machine au-dessus." %}
              {% render 'rc-guide-faq-item', question: "Je peux l'emmener tout de suite ?", answer: "Oui. Prêt à rouler, 2 batteries offertes. Tu sors, tu cherches le prochain obstacle." %}
              {% render 'rc-guide-faq-item', question: "Autonomie longue ?", answer: "Souvent plus qu'un brushless lancé à fond, parce que tu roules lentement. Les 2 packs inclus tiennent une vraie session. Tu en ajoutes si tu veux rester dehors." %}

            {% else %}
              {% render 'rc-guide-faq-item', question: "Par où je commence ?", answer: "Le terrain. Jardin et herbe : 4x4 ou buggy. Parking et salon : drift ou piste. Ensuite tu prends la vitesse qui te fait kiffer, elle est sur la fiche." %}
              {% render 'rc-guide-faq-item', question: "Les batteries sont fournies ?", answer: "Oui. 2 batteries offertes par véhicule. Pack duo : 4. Pack trio : 7. Tu en ajoutes encore sur la fiche si tu veux rouler sans t'arrêter." %}
              {% render 'rc-guide-faq-item', question: "Le SAV est en France ?", answer: "Oui. Une vraie personne, photo ou vidéo, on t'oriente. Réponse sous 24 à 48 heures." %}
              {% render 'rc-guide-faq-item', question: "Je peux renvoyer si ça ne me plaît pas ?", answer: "Oui, 30 jours, produit non utilisé, complet, emballage d'origine. Tu commandes, tu testes, tu décides." %}
          {% endcase %}
        </div>
      </div>

      <div class="rc-guide-photos">
        <figure>
          <img
            src="{{ photo | asset_url }}"
            alt="{{ photo_alt | escape }}"
            width="1400"
            height="875"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 900px) 38vw, 100vw"
          >
        </figure>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guide collection RC",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [],
  "presets": [
    {
      "name": "Guide collection RC"
    }
  ]
}
{% endschema %}
