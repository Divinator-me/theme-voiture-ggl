{{ 'collection-guide-rc.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign handle = collection.handle
  assign guide_title = 'Bien choisir sa RC'
  assign photo = 'rc-guide-default-1.webp'
  assign photo_alt = "Atelier RC LAB, châssis en cours de réglage"

  case handle
    when 'monster-truck-4x4'
      assign guide_title = 'Bien choisir son monster truck'
      assign photo = 'rc-guide-monster-1.webp'
      assign photo_alt = 'Monster truck RC en saut sur rampe'
    when 'buggy'
      assign guide_title = 'Bien choisir son buggy'
      assign photo = 'rc-guide-buggy-1.webp'
      assign photo_alt = "Montage d'un buggy RC sur le sol de l'atelier"
    when 'rallye-trophy'
      assign guide_title = 'Bien choisir son rallye'
      assign photo = 'rc-guide-rallye-1.webp'
      assign photo_alt = 'Session outdoor rallye trophy RC'
    when 'drift'
      assign guide_title = 'Bien choisir son drift'
      assign photo = 'rc-guide-drift-1.webp'
      assign photo_alt = 'Voiture RC drift en intérieur'
    when 'piste'
      assign guide_title = 'Bien choisir sa piste'
      assign photo = 'rc-guide-piste-1.webp'
      assign photo_alt = 'Pilotes RC sur un circuit'
    when 'crawler'
      assign guide_title = 'Bien choisir son crawler'
      assign photo = 'rc-guide-crawler-1.webp'
      assign photo_alt = 'Crawler RC encore boueux après un passage en forêt'
  endcase
-%}

<section class="rc-guide" aria-label="{{ guide_title | escape }}">
  <span class="rc-guide__glow" aria-hidden="true"></span>

  <div class="rc-guide__inner">
    <div class="rc-guide__choose">
      <h2 class="rc-guide__label">{{ guide_title }}</h2>

      {% case handle %}
        {% when 'monster-truck-4x4' %}
          <article>
            <h3>Le 4x4, c'est celui qui sort</h3>
            <p>Herbe, terre, montée, parking cabossé. Une propulsion patine dès que ça devient gras. Les 4x4 de cette page tiennent parce que les quatre roues tirent. Tu les sors, elles roulent. C'est ça, une RC qui ne finit pas au fond d'un carton.</p>
          </article>
          <article>
            <h3>La vitesse, c'est le souvenir</h3>
            <p>La gamme monte à 85 km/h en brushless. Plus tu as d'espace, plus tu prends haut. La fiche affiche la pointe, tu prends celle qui te fait du bien. Le modèle au-dessus n'attend pas que tu "mérites" d'aller plus vite.</p>
          </article>
          <article>
            <h3>Brushless, pour qu'elle tire encore l'an prochain</h3>
            <p>Plus de couple, un moteur qui ne s'essouffle pas au bout de trois week-ends. Sur nos 4x4 les plus rapides, c'est ce palier qui sépare une session nerveuse d'une voiture déjà molle. Si tu veux que le plaisir dure, tu le prends.</p>
          </article>
          <article>
            <h3>Une après-midi, pas un essai</h3>
            <p>2 batteries offertes dans la boîte. Compte 25 minutes en moyenne par pack, selon le modèle. Les batteries en plus, tu les changes sur le terrain et tu restes dehors. C'est comme ça qu'une RC devient une habitude.</p>
          </article>

        {% when 'buggy' %}
          <article>
            <h3>Le buggy, c'est celui qui réagit</h3>
            <p>Plus léger qu'un monster truck, plus vif sur terre. Tu changes de direction, tu traces, tu relances. Si tu veux piloter, pas seulement encaisser, c'est cette grille. Les modèles au-dessus sont choisis pour ça.</p>
          </article>
          <article>
            <h3>Terre, herbe rase, champ</h3>
            <p>C'est leur terrain. Un buggy RC LAB, tu le sors, tu rentres avec de la poussière sur le châssis. Pas une auto de salon. Tu as un jardin un peu ouvert, tu as déjà de quoi t'amuser.</p>
          </article>
          <article>
            <h3>L'échelle, c'est la présence</h3>
            <p>Un 1/16 part dans un sac. Un 1/10 a plus de gueule et demande de la place pour utiliser la vitesse. Les deux sont là. Tu prends selon l'espace, tu ne te prives pas de la machine qui te plaît.</p>
          </article>
          <article>
            <h3>Brushless, pour garder le punch</h3>
            <p>Nos buggys les plus rapides tiennent 70 à 75 km/h. Le brushless reste nerveux quand tu enchaînes. 2 batteries offertes. Tu ajoutes des packs sur la fiche, tu changes sur place, la session ne s'arrête pas à la première charge.</p>
          </article>

        {% when 'rallye-trophy' %}
          <article>
            <h3>Une auto qui ressemble à quelque chose</h3>
            <p>Le rallye, c'est le look d'une vraie, et le droit de sortir. Terre, gravier, un peu de bitume. Tu n'es pas coincé au parking. Les répliques et les trophy de cette page sont là pour rouler, pas pour rester en vitrine.</p>
          </article>
          <article>
            <h3>Réplique ou trophy, tu sors quand même</h3>
            <p>Une C3 WRC, ça a une gueule dès qu'on ouvre la boîte. Un trophy passe plus de bosses. Les deux avancent. Tu achètes ce que tu as envie de regarder, et tu l'emmènes dehors le week-end d'après.</p>
          </article>
          <article>
            <h3>Le cadeau qui s'utilise</h3>
            <p>Parents, premier achat, envie d'une auto "comme une vraie" : c'est cette collection. Prêt à rouler, 2 batteries dans la boîte. Le SAV France répond sous 24 à 48 heures si un truc coince. Tu n'achètes pas un jouet jetable.</p>
          </article>
          <article>
            <h3>L'après-midi se joue aux batteries</h3>
            <p>25 minutes en moyenne par pack, selon le modèle. 2 offertes, tu enchaînes déjà. Les supplémentaires, tu les changes sur le terrain. C'est la différence entre rentrer trop tôt et rester jusqu'à ce qu'il fasse nuit.</p>
          </article>

        {% when 'drift' %}
          <article>
            <h3>Tu n'achètes pas une ligne droite</h3>
            <p>Tu achètes l'angle, la trajectoire, le contrôle. Nos drifts arrivent montées pour glisser, pneus compris. Le plaisir n'est pas "aller tout droit plus vite". C'est tenir le slide. C'est pour ça que les gens y restent.</p>
          </article>
          <article>
            <h3>Chez toi, ça glisse déjà</h3>
            <p>Carrelage, garage, parking. Un 1/24 se sort entre quatre murs. Les plus grandes veulent un sol dur un peu plus ouvert. Tu n'as pas besoin d'un jardin. Tu prends le format qui rentre dans ta pièce, il est dans la grille.</p>
          </article>
          <article>
            <h3>Le skill, ça s'apprend en roulant</h3>
            <p>Les premières minutes, ça part. Après un pack, tu commences à tenir. Plus tu roules, plus c'est bon. D'où les 2 batteries offertes, et les packs en plus sur la fiche : tu changes sur place, tu enchaînes les runs, tu progresses.</p>
          </article>
          <article>
            <h3>Jusqu'à 65 km/h, prêt à partir</h3>
            <p>Rien à monter pour commencer. La fiche affiche la pointe. Tu ouvres, tu charges, tu glisses. SAV France si tu bloques. 30 jours pour changer d'avis. Tu prends celle qui te fait de l'œil au-dessus.</p>
          </article>

        {% when 'piste' %}
          <article>
            <h3>Une autre façon de piloter</h3>
            <p>Basse, nerveuse, sol lisse. Asphalte, carrelage, parking. Tu places la voiture, tu apprends la ligne. Ce n'est pas un 4x4. C'est pour ça que beaucoup en gardent une des deux, ou les deux. Le plaisir n'est pas le même, il s'ajoute.</p>
          </article>
          <article>
            <h3>Le sol que tu as, c'est déjà assez</h3>
            <p>Un parking, une allée, un salon en 1/24. Si tu as du dur sous les roues, une piste a sa place. Les modèles au-dessus sont faits pour ça. L'herbe, c'est une autre collection. Ici, tu achètes la précision.</p>
          </article>
          <article>
            <h3>L'échelle, selon la pièce</h3>
            <p>Les 1/24 se sortent tout de suite, même au chaud. Les plus grandes veulent un vrai tracé. Tu ne te prives pas : tu prends le format qui rentre chez toi, la session commence le jour où elle arrive.</p>
          </article>
          <article>
            <h3>2 batteries, tu enchaînes les tours</h3>
            <p>25 minutes en moyenne par pack, selon le modèle. 2 offertes. Les supplémentaires, tu les changes sur place. Une piste, ça se mérite au tour. Plus tu restes, plus tu la tiens. C'est ça qu'on met dans la boîte.</p>
          </article>

        {% when 'crawler' %}
          <article>
            <h3>Le spectacle, c'est la grimpe</h3>
            <p>Un crawler ne chasse pas la pointe. Il cherche la ligne, le couple, le passage. Tu t'arrêtes en pente, tu relances, tu passes. C'est un autre jeu, plus posé, plus technique. Les modèles de cette page sont choisis pour ça.</p>
          </article>
          <article>
            <h3>Le terrain que tu as déjà</h3>
            <p>Racines, muret, tas de bois, jardin accidenté. Pas besoin d'un circuit. Si tu as du relief, tu as ta machine. Double moteur, réplique 1/12, 4x4 lent : tu prends celle qui correspond à tes obstacles, elle est au-dessus.</p>
          </article>
          <article>
            <h3>Prêt à sortir de la boîte</h3>
            <p>Pas des heures de réglages. Tu charges, tu vas chercher le prochain obstacle. Kit pièces, SAV France sous 24 à 48 heures. Une RC qui se répare, pas un jouet qu'on jette. C'est la marque qu'on a montée pour ça.</p>
          </article>
          <article>
            <h3>Tu roules doucement, tu restes plus longtemps</h3>
            <p>2 batteries offertes. Compte 25 minutes en moyenne par pack, selon le modèle. Comme tu ne tires pas à fond, la session tient. Les batteries en plus, tu les changes sur place et tu continues les passages.</p>
          </article>

        {% else %}
          <article>
            <h3>Le terrain, avant la fiche</h3>
            <p>Jardin et herbe : 4x4 ou buggy. Parking et salon : drift ou piste. Chaque gamme RC LAB est faite pour un usage réel. Tu choisis le sol, tu tombes sur les modèles qui vont avec. C'est comme ça qu'une RC sert, au lieu de rester neuve.</p>
          </article>
          <article>
            <h3>La vitesse, selon ce que tu veux sentir</h3>
            <p>La boutique va jusqu'aux brushless les plus rapides. La fiche affiche la pointe. Tu prends celle qui te fait du bien. Personne ici ne te dit de viser plus petit "pour commencer".</p>
          </article>
          <article>
            <h3>Brushless, le palier qui dure</h3>
            <p>Brushed : simple, costaud. Brushless : plus de punch, moins d'usure. Si tu veux une voiture qui tire encore dans un an, tu montes ce palier. Il est dans le catalogue, tu le prends quand tu le veux, y compris tout de suite.</p>
          </article>
          <article>
            <h3>2 batteries, déjà. Le reste, tu l'ajoutes</h3>
            <p>Chaque véhicule part avec 2 packs. 25 minutes en moyenne, selon le modèle. Pack duo, pack trio, batteries en plus sur la fiche. Tu changes sur le terrain, tu continues. Le SAV France est là. 30 jours pour changer d'avis.</p>
          </article>
      {% endcase %}
    </div>

    <div class="rc-guide__side">
      <div class="rc-guide-faq">
        <h2>Questions fréquentes</h2>

        <div class="rc-guide-faq__list">
          {% case handle %}
            {% when 'monster-truck-4x4' %}
              {% render 'rc-guide-faq-item', question: "Elle passe vraiment dans l'herbe ?", answer: "Oui. Quatre roues motrices, c'est fait pour ça. Une RC 2 roues motrices patine au premier pré. Ici tu prends un 4x4 pour le sortir, pas pour le regarder." %}
              {% render 'rc-guide-faq-item', question: "Je vise quelle vitesse ?", answer: "Celle qui te fait plaisir. La gamme monte à 85 km/h en brushless. Plus tu as d'espace, plus tu prends haut. La fiche l'affiche, le modèle est prêt, 2 batteries dans la boîte." %}
              {% render 'rc-guide-faq-item', question: "Combien de batteries pour une après-midi ?", answer: "2 offertes. Compte 25 minutes en moyenne par pack, ça dépend du modèle et de la batterie. Avec des packs en plus, tu changes direct sur le terrain et tu continues, sans rentrer charger." %}
              {% render 'rc-guide-faq-item', question: "Elle va tenir, ou je rachète dans deux mois ?", answer: "On vise plusieurs saisons, pas trois sorties. Métal aux points critiques, kit pièces, SAV France sous 24 à 48 heures. Photo ou vidéo, un humain t'oriente. Tu n'achètes pas un jouet Amazon à jeter." %}

            {% when 'buggy' %}
              {% render 'rc-guide-faq-item', question: "Pourquoi un buggy plutôt qu'un 4x4 ?", answer: "Parce que tu veux de la vive. Un buggy change de direction, un 4x4 encaisse. Si tu vises terre, traces, relances, c'est cette grille. Les deux collections existent. Tu prends celle que tu as envie de piloter." %}
              {% render 'rc-guide-faq-item', question: "J'ai un jardin, ça suffit ?", answer: "Oui s'il est un peu ouvert. Un 1/10 brushless demande plus d'espace pour utiliser la vitesse. C'est pour ça qu'on a plusieurs échelles : tu prends celle qui rentre chez toi, tu ne te prives pas du modèle qui te plaît." %}
              {% render 'rc-guide-faq-item', question: "Je prends brushless tout de suite ?", answer: "Si tu veux le punch dès le premier week-end, oui. C'est le moteur qui reste nerveux dans le temps. Les buggys brushless de la page sont là pour ça, pas pour plus tard." %}
              {% render 'rc-guide-faq-item', question: "Combien de temps je roule avec les 2 batteries ?", answer: "25 minutes en moyenne par pack, selon le modèle. 2 offertes, tu enchaînes déjà. Tu en ajoutes sur la fiche, tu changes sur place, l'après-midi ne s'arrête pas à la première charge." %}

            {% when 'rallye-trophy' %}
              {% render 'rc-guide-faq-item', question: "Ça roule où, concrètement ?", answer: "Terre, gravier, un peu de route. C'est le mix. Tu n'es pas collé au parking, tu n'as pas besoin d'un champ entier. Pour du drift pur, la collection Drift est à côté. Ici tu prends une auto qui avance partout." %}
              {% render 'rc-guide-faq-item', question: "La carrosserie, ça casse au premier choc ?", answer: "Elle prend, comme une vraie. Le châssis est dimensionné pour sortir, pas pour la vitrine. Kit pièces, SAV France. Tu l'achètes pour t'en servir, on l'a choisie pour ça." %}
              {% render 'rc-guide-faq-item', question: "C'est un bon premier achat ?", answer: "Oui si tu veux une auto qui a une gueule dès qu'on ouvre la boîte. Prêt à rouler, 2 batteries, livraison offerte. 30 jours pour changer d'avis. Les modèles au-dessus partent comme ça." %}
              {% render 'rc-guide-faq-item', question: "Quelle autonomie ?", answer: "25 minutes en moyenne par batterie, ça dépend du modèle et du pack. 2 offertes. Les supplémentaires, tu les changes sur le terrain et l'après-midi continue." %}

            {% when 'drift' %}
              {% render 'rc-guide-faq-item', question: "Je peux glisser chez moi ?", answer: "Sol dur, carrelage, garage, parking : oui. Un 1/24 se sort au salon. Moquette, ça ne glisse pas. Tu prends le format selon la pièce, il est dans la grille." %}
              {% render 'rc-guide-faq-item', question: "Il faut des pneus à part ?", answer: "Non. Elles partent avec des pneus drift. Tu ouvres, tu charges, tu glisses. Rien à commander en plus pour commencer." %}
              {% render 'rc-guide-faq-item', question: "Je vais y arriver dès la première session ?", answer: "Les premières minutes, ça part. Après un pack, tu commences à tenir l'angle. Plus tu roules, plus c'est bon. D'où les batteries en plus : tu changes sur place, tu enchaînes, tu progresses." %}
              {% render 'rc-guide-faq-item', question: "Combien de batteries pour enchaîner ?", answer: "2 offertes, 25 minutes en moyenne par pack selon le modèle. Tu en ajoutes sur la fiche, tu changes direct, tu restes sur le drift au lieu de rentrer charger." %}

            {% when 'piste' %}
              {% render 'rc-guide-faq-item', question: "Elle va dans l'herbe ?", answer: "Non. Sol dur uniquement. Pour le jardin, un 4x4 ou un buggy. Ici tu achètes la précision sur asphalte, parking, carrelage. Si tu as ce sol, tu as ta collection." %}
              {% render 'rc-guide-faq-item', question: "Salon ou parking ?", answer: "Les petites échelles se sortent au chaud. Les plus grandes veulent un tracé. L'échelle est sur la fiche. Tu prends celle qui rentre chez toi, tu roules le jour où elle arrive." %}
              {% render 'rc-guide-faq-item', question: "Pourquoi une piste si j'ai déjà un 4x4 ?", answer: "Parce que ce n'est pas le même plaisir. Le 4x4, c'est le chaos dehors. La piste, c'est la ligne. Beaucoup gardent les deux. L'une n'empêche pas l'autre, elle s'ajoute." %}
              {% render 'rc-guide-faq-item', question: "Ça survit à un mur ?", answer: "Tu vises moins les murs, c'est le jeu. Un choc de parking reste gérable. Kit pièces, SAV France. 2 batteries pour enchaîner les tours. Tu l'achètes pour courir, pas pour la poser." %}

            {% when 'crawler' %}
              {% render 'rc-guide-faq-item', question: "Si c'est lent, où est le plaisir ?", answer: "Dans le passage. Tu grimpes, tu t'arrêtes, tu négocies. Ce n'est pas une course. C'est pour ça que les gens prennent un crawler, et souvent ils le gardent. La vitesse, c'est une autre collection, à côté." %}
              {% render 'rc-guide-faq-item', question: "J'ai besoin de quel terrain ?", answer: "Du relief. Racines, muret, tas de bois, jardin accidenté. Un salon plat, non. Si tu as ça chez toi, tu as déjà de quoi jouer. La machine est au-dessus." %}
              {% render 'rc-guide-faq-item', question: "Je sors la boîte et je roule ?", answer: "Oui. Prêt à partir, 2 batteries offertes. Pas des heures de réglages. SAV France sous 24 à 48 heures si tu bloques. Tu vas chercher le prochain obstacle, c'est tout." %}
              {% render 'rc-guide-faq-item', question: "Les 2 batteries, ça tient combien ?", answer: "25 minutes en moyenne par pack, selon le modèle. Comme tu roules doucement, la session tient. Tu en ajoutes, tu changes sur place, tu restes sur tes passages." %}

            {% else %}
              {% render 'rc-guide-faq-item', question: "Par où je commence ?", answer: "Le terrain. Jardin et herbe : 4x4 ou buggy. Parking et salon : drift ou piste. Ensuite tu prends la vitesse qui te fait plaisir, elle est sur la fiche. Les modèles sont prêts." %}
              {% render 'rc-guide-faq-item', question: "Les batteries sont fournies ?", answer: "Oui. 2 par véhicule. 25 minutes en moyenne par pack, selon le modèle. Pack duo : 4. Pack trio : 7. Tu en ajoutes encore sur la fiche, tu changes sur le terrain, tu continues." %}
              {% render 'rc-guide-faq-item', question: "Le SAV est en France ?", answer: "Oui. Un humain, photo ou vidéo, on t'oriente. Réponse sous 24 à 48 heures. Kit pièces sur chaque RCLAB. Tu n'es pas seul avec un jouet mort." %}
              {% render 'rc-guide-faq-item', question: "Je peux renvoyer si ça ne me plaît pas ?", answer: "Oui, 30 jours, produit non utilisé, complet, emballage d'origine. Tu commandes, tu ouvres, tu décides. Livraison offerte en France." %}
          {% endcase %}
        </div>
      </div>

      <div class="rc-guide-photos">
        <figure>
          <img
            src="{{ photo | asset_url }}"
            alt="{{ photo_alt | escape }}"
            width="1400"
            height="875"
            loading="lazy"
            decoding="async"
            sizes="(min-width: 900px) 38vw, 100vw"
          >
        </figure>
      </div>
    </div>
  </div>
</section>

{% schema %}
