{%- liquid
  assign extra = all_products['batterie-supplementaire-produit-rc-lab']
  assign extra_variant = extra.selected_or_first_available_variant
  assign current = product | default: closest.product
-%}

{%- if extra != empty and extra.id and extra_variant and current.handle != extra.handle -%}
  <div
    class="rc-extra-batteries variant-option"
    data-variant-id="{{ extra_variant.id }}"
    data-qty="0"
  >
    <div class="rc-extra-batteries__head">
      <p class="rc-extra-batteries__title">Des Batteries Supplémentaires ?</p>
      <span class="rc-extra-batteries__price">{{ extra_variant.price | money }} / unité</span>
    </div>

    <div class="rc-extra-batteries__grid" role="radiogroup" aria-label="Batteries supplémentaires">
      {%- for count in (0..7) -%}
        <label class="variant-option__button-label">
          <input
            type="radio"
            name="rc-extra-batteries"
            value="{{ count }}"
            data-variant-id="{{ extra_variant.id }}"
            {% if count == 0 %}
              checked
            {% endif %}
          >
          <span class="variant-option__button-label__text">
            {%- if count == 0 -%}
              Aucune
            {%- else -%}
              {{ count }}
            {%- endif -%}
          </span>
        </label>
      {%- endfor -%}
    </div>
  </div>
  <script src="{{ 'rc-extra-batteries.js' | asset_url }}" defer></script>
{%- endif -%}
