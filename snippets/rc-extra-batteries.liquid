{%- liquid
  assign extra = all_products['batterie-supplementaire-produit-rc-lab']
  assign extra_variant = extra.selected_or_first_available_variant
  assign current = product | default: closest.product
-%}

{%- if extra != empty and extra.id and extra_variant and current.handle != extra.handle and current.handle != 'chargeur-secteur-haute-capacite-rc-lab' and current.handle != 'batterie-offerte-produit-rc-lab' -%}
  <div
    class="rc-extra-batteries variant-option"
    data-variant-id="{{ extra_variant.id }}"
    data-qty="0"
  >
    <div class="rc-extra-batteries__head">
      <label class="rc-extra-batteries__title" for="rc-extra-batteries">Des Batteries Supplémentaires ?</label>
      <span class="rc-extra-batteries__price">{{ extra_variant.price | money }} / unité</span>
    </div>

    <div class="rc-extra-batteries__select-wrap">
      <select
        id="rc-extra-batteries"
        class="rc-extra-batteries__select"
        name="rc-extra-batteries"
        data-variant-id="{{ extra_variant.id }}"
        aria-label="Nombre de batteries supplémentaires"
      >
        {%- for count in (0..7) -%}
          <option value="{{ count }}"{% if count == 0 %} selected{% endif %}>
            {%- if count == 0 -%}
              Aucune
            {%- elsif count == 1 -%}
              1 batterie
            {%- else -%}
              {{ count }} batteries
            {%- endif -%}
          </option>
        {%- endfor -%}
      </select>
      <svg class="rc-extra-batteries__caret" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
        <path d="M1 1.2 5 5l4-3.8" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
  <script src="{{ 'rc-extra-batteries.js' | asset_url }}" defer></script>
{%- endif -%}
