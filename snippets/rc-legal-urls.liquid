{%- comment -%}
  URLs canoniques légales RCLAB (GMC).
  Politiques Shopify : /policies/* — Pages custom : contact, paiement, FAQ.
  Utiliser : {% render 'rc-legal-urls', part: 'contact' %}
{%- endcomment -%}

{%- liquid
  assign rc_contact_page = pages['contact']
  assign rc_paiement_page = pages['conditions-paiement']
  assign rc_faq_boutique_page = pages['faq-boutique']

  assign rc_contact_url = rc_contact_page.url | default: '/pages/contact'
  assign rc_retours_url = shop.refund_policy.url | default: '/policies/refund-policy'
  assign rc_livraison_url = shop.shipping_policy.url | default: '/policies/shipping-policy'
  assign rc_cgv_url = shop.terms_of_service.url | default: '/policies/terms-of-service'
  assign rc_confidentialite_url = shop.privacy_policy.url | default: '/policies/privacy-policy'
  assign rc_paiement_url = rc_paiement_page.url | default: '/pages/conditions-paiement'
  if rc_faq_boutique_page != blank
    assign rc_faq_boutique_url = rc_faq_boutique_page.url
  else
    assign rc_faq_boutique_url = routes.root_url | append: '#faq'
  endif
-%}

{%- case part -%}
  {%- when 'contact' -%}{{ rc_contact_url }}
  {%- when 'retours' -%}{{ rc_retours_url }}
  {%- when 'livraison' -%}{{ rc_livraison_url }}
  {%- when 'cgv' -%}{{ rc_cgv_url }}
  {%- when 'confidentialite' -%}{{ rc_confidentialite_url }}
  {%- when 'paiement' -%}{{ rc_paiement_url }}
  {%- when 'faq-boutique' -%}{{ rc_faq_boutique_url }}
{%- endcase -%}
