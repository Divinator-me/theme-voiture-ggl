{% capture rc_delay %}{% render 'rc-delivery-delay', product: product %}{% endcapture %}
{% assign rc_delay = rc_delay | strip %}
<div class="shipping-bar">
  <div class="shipping-left">
    <div class="shipping-dot"></div>
    <span>Livraison <span class="shipping-bold">{{ rc_delay }}</span> · France métropolitaine</span>
  </div>
  <div class="shipping-right">
    <span>
      <svg
        class="shipping-flag"
        viewBox="0 0 24 16"
        width="14"
        height="10"
        aria-hidden="true"
        focusable="false"
      >
        <rect width="8" height="16" fill="#002395"></rect>
        <rect x="8" width="8" height="16" fill="#ffffff"></rect>
        <rect x="16" width="8" height="16" fill="#ed2939"></rect>
      </svg>
      Livraison <span class="shipping-bold">Gratuite</span>
    </span>
  </div>
</div>
<p class="rc-service-banner">
  <span class="rc-service-banner__brand">RCLAB</span>
  <span class="rc-service-banner__dots"> ... </span>
  <span class="rc-service-banner__claim">Le MEILLEUR SERVICE CLIENT FR</span>
</p>
