{%- doc -%}
  Bulle service client et offres, hors du conteneur qui scrolle.
{%- enddoc -%}

{{ 'rc-help.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rc_help_subject = 'vos voitures RC'
  if request.page_type == 'product' and product.title != blank
    assign rc_help_subject = product.title
  endif
  assign rc_help_message = "Bonjour, j'ai une question sur " | append: rc_help_subject | append: '.'
  assign rc_help_query = rc_help_message | url_encode
  assign rc_help_wa = 'https://wa.me/33756884492?text=' | append: rc_help_query
-%}

<div class="rc-help" data-rc-help>
  <div class="rc-help__panel rc-help__panel--chat" id="rc-help-chat" hidden>
    <div class="rc-help__chat-head">
      <img
        class="rc-help__avatar"
        src="{{ 'expert-rc-leo.jpg' | asset_url }}"
        alt=""
        width="38"
        height="38"
      >
      <span class="rc-help__identity">
        <span class="rc-help__name">RCLAB</span>
        <span class="rc-help__role">Service client</span>
      </span>
      <button class="rc-help__close rc-help__close--light" type="button" data-rc-help-close aria-label="Fermer le service client">
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="rc-help__chat-body">
      <div class="rc-help__hello">
        <p>Bonjour. Une question sur {{ rc_help_subject | escape }} ? Écrivez-nous, on vous répond directement.</p>
        <p class="rc-help__when">Réponse dès 9 h</p>
      </div>
      <a class="rc-help__wa-link" href="{{ rc_help_wa }}" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.41a10.1 10.1 0 0 0 4.65 1.12h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.76 14.15c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.12.1-1.81-.11-.42-.13-.95-.3-1.64-.59-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.24-.26.64-.38 1.02-.38.12 0 .23 0 .33.01.3.01.45.03.65.5.24.58.82 2 .89 2.15.07.14.12.32.02.51-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.13-.28.28-.12.54.16.26.7 1.15 1.5 1.87 1.03.92 1.9 1.2 2.16 1.34.26.13.42.11.57-.07.16-.19.67-.78.85-1.05.18-.26.36-.22.6-.13.24.1 1.53.72 1.79.85.26.13.44.19.5.3.07.11.07.64-.17 1.32z"/></svg>
        Discuter sur WhatsApp
      </a>
      <p class="rc-help__note">Spécialiste des voitures RC. Réponse rapide.</p>
    </div>
  </div>

  <div class="rc-help__panel rc-help__panel--offers" id="rc-help-offers" hidden>
    <div class="rc-help__offers-head">
      <p class="rc-help__offers-title">Offres exclusives</p>
      <button class="rc-help__close" type="button" data-rc-help-close aria-label="Fermer les offres">
        <svg viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
    <ul class="rc-help__offers">
      <li>
        <span class="rc-help__offer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3.2l2.1 4.7 5.1.6-3.8 3.5.9 5.1L12 14.8 7.7 17.1l.9-5.1L4.8 8.5l5.1-.6L12 3.2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </span>
        <span>
          <span class="rc-help__offer-title">Pack duo <span class="rc-help__hot">−10 %</span>, pack trio <span class="rc-help__hot">−20 %</span></span>
          <span class="rc-help__offer-text">Le rabais est déjà dans le prix du pack.</span>
        </span>
      </li>
      <li>
        <span class="rc-help__offer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M4 11h16v8.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V11z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 11v9.5M4 11l2.2-5.2A1 1 0 0 1 7.1 5h9.8a1 1 0 0 1 .9.8L20 11" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </span>
        <span>
          <span class="rc-help__offer-title">Batteries offertes</span>
          <span class="rc-help__offer-text">Elles partent avec le véhicule, rien à ajouter.</span>
        </span>
      </li>
      <li>
        <span class="rc-help__offer-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M3 7.5h11.5v8H3v-8z" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M14.5 10.5H19l2 2.4V15.5h-6.5v-5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="7" cy="17.6" r="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="17.6" r="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </span>
        <span>
          <span class="rc-help__offer-title">Livraison offerte en France</span>
          <span class="rc-help__offer-text">Colis suivi, assurance vol et casse offerte.</span>
        </span>
      </li>
    </ul>
    <p class="rc-help__offers-foot">Déjà inclus. Aucun code à saisir.</p>
  </div>

  <div class="rc-help__stack">
    <button
      class="rc-help__wa"
      type="button"
      data-rc-help-open="chat"
      aria-expanded="false"
      aria-controls="rc-help-chat"
      aria-label="Ouvrir le service client WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.41a10.1 10.1 0 0 0 4.65 1.12h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.76 14.15c-.24.68-1.4 1.25-1.94 1.33-.5.07-1.12.1-1.81-.11-.42-.13-.95-.3-1.64-.59-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.24-.26.64-.38 1.02-.38.12 0 .23 0 .33.01.3.01.45.03.65.5.24.58.82 2 .89 2.15.07.14.12.32.02.51-.09.19-.14.31-.28.48-.14.16-.29.36-.42.48-.14.13-.28.28-.12.54.16.26.7 1.15 1.5 1.87 1.03.92 1.9 1.2 2.16 1.34.26.13.42.11.57-.07.16-.19.67-.78.85-1.05.18-.26.36-.22.6-.13.24.1 1.53.72 1.79.85.26.13.44.19.5.3.07.11.07.64-.17 1.32z"/></svg>
    </button>
    <button
      class="rc-help__gift"
      type="button"
      data-rc-help-open="offers"
      aria-expanded="false"
      aria-controls="rc-help-offers"
      aria-label="Ouvrir les offres exclusives, 3 offres"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16v8.5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V11z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M12 11v9.5M4 11l2.2-5.2A1 1 0 0 1 7.1 5h9.8a1 1 0 0 1 .9.8L20 11" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
      <span class="rc-help__badge">3</span>
    </button>
  </div>
</div>

<script src="{{ 'rc-help.js' | asset_url }}" defer></script>
