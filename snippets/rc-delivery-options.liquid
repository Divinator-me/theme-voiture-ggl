{% liquid
  assign offer_handles = ''
  case product.handle
    when 'sweep-pro-4x4-70-kmh-rclab' or 'sweep-pro-4x4-rc-1-16-brushless-70-km-h-avec-led-livraison-3-a-8-jours'
      assign offer_handles = 'sweep-pro-4x4-70-kmh-rclab|sweep-pro-4x4-rc-1-16-brushless-70-km-h-avec-led-livraison-3-a-8-jours'
    when '4x4-tout-terrain-1-16-50-km-h' or 'conquer-4x4-rc-1-16-tout-terrain-50-km-h-plusieurs-coloris-livraison-2-a-6-jours-1'
      assign offer_handles = '4x4-tout-terrain-1-16-50-km-h|conquer-4x4-rc-1-16-tout-terrain-50-km-h-plusieurs-coloris-livraison-2-a-6-jours-1'
    when '4x4-rc-1-16-brushless-70-kmh-rclab' or 'gantry-pro-4x4-off-road-rc-1-16-brushless-70-km-h-chassis-carbone-livraison-7-a-14-jours'
      assign offer_handles = '4x4-rc-1-16-brushless-70-kmh-rclab|gantry-pro-4x4-off-road-rc-1-16-brushless-70-km-h-chassis-carbone-livraison-7-a-14-jours'
    when 'buggy-off-road-4x4-1-16-rclab' or 'buggy-off-road-4x4-rc-1-16-50-km-h-avec-led-livraison-2-a-6-jours'
      assign offer_handles = 'buggy-off-road-4x4-1-16-rclab|buggy-off-road-4x4-rc-1-16-50-km-h-avec-led-livraison-2-a-6-jours'
    when 'hyper-go-tout-terrain-4wd-50km-h' or 'hyper-go-4x4-rc-1-14-brushless-50-km-h-tout-terrain-livraison-10-jours-a-3-semaines-et-demie' or 'hyper-go-4x4-rc-1-14-brushless-50-km-h-tout-terrain-livraison-4-a-8-jours' or 'hyper-go-4x4-rc-1-14-brushless-50-km-h-tout-terrain-livraison-3-a-6-jours'
      assign offer_handles = 'hyper-go-tout-terrain-4wd-50km-h|hyper-go-4x4-rc-1-14-brushless-50-km-h-tout-terrain-livraison-10-jours-a-3-semaines-et-demie|hyper-go-4x4-rc-1-14-brushless-50-km-h-tout-terrain-livraison-4-a-8-jours|hyper-go-4x4-rc-1-14-brushless-50-km-h-tout-terrain-livraison-3-a-6-jours'
    when '4x4-brushless-1-16-85-km-h' or 'sprint-4x4-rc-1-16-brushless-85-km-h-livraison-6-a-16-jours'
      assign offer_handles = '4x4-brushless-1-16-85-km-h|sprint-4x4-rc-1-16-brushless-85-km-h-livraison-6-a-16-jours'
    when '4x4-rc-1-14-brushless-60-kmh-rclab' or '4wd-off-road-4x4-rc-1-16-brushless-60-km-h-moteur-sans-charbon-livraison-1-a-4-semaines' or '4wd-off-road-4x4-rc-1-16-brushless-60-km-h-moteur-sans-charbon-livraison-1-a-2-semaines'
      assign offer_handles = '4x4-rc-1-14-brushless-60-kmh-rclab|4wd-off-road-4x4-rc-1-16-brushless-60-km-h-moteur-sans-charbon-livraison-1-a-4-semaines|4wd-off-road-4x4-rc-1-16-brushless-60-km-h-moteur-sans-charbon-livraison-1-a-2-semaines'
    when 'rapidly-4x4-1-16-50-kmh-rclab' or 'rapidly-rc-1-16-4x4-tout-terrain-50-km-h-avec-led-livraison-2-a-5-jours'
      assign offer_handles = 'rapidly-4x4-1-16-50-kmh-rclab|rapidly-rc-1-16-4x4-tout-terrain-50-km-h-avec-led-livraison-2-a-5-jours'
    when 'crawler-4x4-1-16-double-moteur-rclab' or 'crawler-rc-4x4-1-16-double-moteur-franchissement-12-km-h-livraison-1-a-2-semaines'
      assign offer_handles = 'crawler-4x4-1-16-double-moteur-rclab|crawler-rc-4x4-1-16-double-moteur-franchissement-12-km-h-livraison-1-a-2-semaines'
    when 'z06-evo-buggy-4x4-rc-1-14-brushless-60-km-h' or 'z06-evo-buggy-4x4-rc-1-14-brushless-60-km-h-livraison-1-semaine'
      assign offer_handles = 'z06-evo-buggy-4x4-rc-1-14-brushless-60-km-h|z06-evo-buggy-4x4-rc-1-14-brushless-60-km-h-livraison-1-semaine'
    when 'z06-evo-buggy-4x4-rc-1-14-brushless-v2-75-km-h-haute-performance' or 'z06-evo-buggy-4x4-rc-1-14-brushless-v2-75-km-h-livraison-1-a-2-semaines'
      assign offer_handles = 'z06-evo-buggy-4x4-rc-1-14-brushless-v2-75-km-h-haute-performance|z06-evo-buggy-4x4-rc-1-14-brushless-v2-75-km-h-livraison-1-a-2-semaines'
    when 'buggy-mantis-1-16-4wd-rclab' or 'buggy-mantis-rc-1-16-4wd-roues-anti-wheeling-livraison-1-a-2-semaines'
      assign offer_handles = 'buggy-mantis-1-16-4wd-rclab|buggy-mantis-rc-1-16-4wd-roues-anti-wheeling-livraison-1-a-2-semaines'
    when 'citroen-c3-wrc-1-14-rc-rallye-rclab' or 'citroen-c3-wrc-rc-1-14-brushless-rallye-et-drift-livraison-3-a-7-jours'
      assign offer_handles = 'citroen-c3-wrc-1-14-rc-rallye-rclab|citroen-c3-wrc-rc-1-14-brushless-rallye-et-drift-livraison-3-a-7-jours'
    when 'polo-r-wrc-1-14-rc-rallye-rclab' or 'volkswagen-polo-r-wrc-rc-1-14-brushless-rallye-et-drift-livraison-1-semaine'
      assign offer_handles = 'polo-r-wrc-1-14-rc-rallye-rclab|volkswagen-polo-r-wrc-rc-1-14-brushless-rallye-et-drift-livraison-1-semaine'
    when 'bmw-m4-gt3-1-24-rc-drift-rclab' or 'bmw-m4-gt3-rc-1-24-drift-et-piste-avec-led-livraison-1-a-2-semaines'
      assign offer_handles = 'bmw-m4-gt3-1-24-rc-drift-rclab|bmw-m4-gt3-rc-1-24-drift-et-piste-avec-led-livraison-1-a-2-semaines'
    when '4x4-tout-terrain-brushless-70-km-h-rclab' or 'drive-4x4-rc-brushless-70-km-h-version-rclab-tout-terrain-v2' or 'drive-4x4-rc-brushless-70-km-h-version-rclab-tout-terrain-v3'
      assign offer_handles = '4x4-tout-terrain-brushless-70-km-h-rclab|drive-4x4-rc-brushless-70-km-h-version-rclab-tout-terrain-v2|drive-4x4-rc-brushless-70-km-h-version-rclab-tout-terrain-v3'
    when 'trophy-truck-rc-1-16-50-kmh-rclab' or 'rapid-trophy-truck-rc-1-16-4x4-50-km-h-avec-led-v2'
      assign offer_handles = 'trophy-truck-rc-1-16-50-kmh-rclab|rapid-trophy-truck-rc-1-16-4x4-50-km-h-avec-led-v2'
    when 'trophy-truck-rc-1-16-brushless-70-rclab' or 'rapid-trophy-truck-rc-1-14-brushless-70-km-h-livraison-5-jours'
      assign offer_handles = 'trophy-truck-rc-1-16-brushless-70-rclab|rapid-trophy-truck-rc-1-14-brushless-70-km-h-livraison-5-jours'
  endcase

  assign offer_list = offer_handles | split: '|'
  assign offer_count = 0
  for offer_handle in offer_list
    assign offer_product = all_products[offer_handle]
    if offer_product != blank
      assign offer_count = offer_count | plus: 1
    endif
  endfor
%}

{%- if offer_count > 1 -%}
  {{ 'rc-delivery-options.css' | asset_url | stylesheet_tag }}
  <section class="rc-delivery-options" data-rc-delivery-options aria-labelledby="rc-delivery-options-title">
    <h2 class="rc-delivery-options__title" id="rc-delivery-options-title">Choisissez votre fournisseur</h2>
    <div class="rc-delivery-options__list" role="list">
      {%- for offer_handle in offer_list -%}
        {%- assign offer_product = all_products[offer_handle] -%}
        {%- if offer_product != blank -%}
          {%- capture offer_delay -%}{%- render 'rc-delivery-delay', product: offer_product -%}{%- endcapture -%}
          {%- assign offer_delay = offer_delay | strip -%}
          {%- capture variants_json -%}[{%- for variant in offer_product.variants -%}{"id":{{ variant.id }},"options":{{ variant.options | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]{%- endcapture -%}
          {%- assign is_current = false -%}
          {%- if offer_product.handle == product.handle -%}
            {%- assign is_current = true -%}
          {%- endif -%}
          <a
            class="rc-delivery-options__card{% if is_current %} is-selected{% endif %}"
            role="listitem"
            href="{{ offer_product.url }}"
            data-rc-delivery-option
            data-variants="{{ variants_json | strip | escape }}"
            {% if is_current %}aria-current="page"{% endif %}
          >
            <span class="rc-delivery-options__radio" aria-hidden="true"></span>
            <span class="rc-delivery-options__price">{{ offer_product.price | money }}</span>
            <span class="rc-delivery-options__delay">{{ offer_delay }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
    <script type="application/json" data-rc-current-variants>
      [
        {%- for variant in product.variants -%}
          {"id":{{ variant.id }},"options":{{ variant.options | json }}}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  </section>
  <script src="{{ 'rc-delivery-options.js' | asset_url }}" defer></script>
{%- endif -%}
