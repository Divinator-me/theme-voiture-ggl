{%- doc -%}
  Email SAV RCLAB — lien mailto: cliquable (exigence GMC).
  @param {string} [class] - classe CSS optionnelle
{%- enddoc -%}

{%- liquid
  assign rc_support_email = 'support@rclab-car.com'
  assign rc_support_email_class = class | default: ''
