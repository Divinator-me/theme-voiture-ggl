{%- doc -%}
  Hex d'une couleur variante RC, d'apres le nom (Noir, Bleu, etc.).
{%- enddoc -%}

{%- liquid
  assign color_name = name | downcase | strip
  assign hex = ''

  if color_name == 'rouge' or color_name contains 'rouge' or color_name == 'red' or color_name contains 'red'
    assign hex = '#FF2D2D'
  elsif color_name == 'vert' or color_name contains 'vert' or color_name == 'green' or color_name contains 'green'
    assign hex = '#16A34A'
  elsif color_name == 'noir' or color_name contains 'noir' or color_name == 'black' or color_name contains 'black'
    assign hex = '#0A0A0A'
  elsif color_name == 'blanc' or color_name contains 'blanc' or color_name == 'white' or color_name contains 'white'
    assign hex = '#FFFFFF'
  elsif color_name == 'bleu' or color_name contains 'bleu' or color_name == 'blue' or color_name contains 'blue'
    assign hex = '#2563EB'
  elsif color_name contains 'orange'
    assign hex = '#FF6B00'
  elsif color_name == 'jaune' or color_name contains 'jaune' or color_name == 'yellow' or color_name contains 'yellow'
    assign hex = '#FACC15'
  elsif color_name == 'gris' or color_name contains 'gris' or color_name contains 'gray' or color_name contains 'grey'
    assign hex = '#737373'
  elsif color_name contains 'violet' or color_name contains 'purple'
    assign hex = '#7C3AED'
  elsif color_name contains 'rose' or color_name contains 'pink'
    assign hex = '#EC4899'
  elsif color_name contains 'argent' or color_name contains 'silver'
    assign hex = '#C0C0C0'
  elsif color_name == 'or' or color_name == 'gold' or color_name contains 'doré' or color_name contains 'dore'
    assign hex = '#D4AF37'
  elsif color_name contains 'camo' or color_name contains 'camouflage'
    assign hex = '#4B5320'
  endif
-%}
{{- hex -}}
