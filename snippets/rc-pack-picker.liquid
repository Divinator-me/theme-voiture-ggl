{%- liquid
  assign pack_product = product | default: closest.product
  assign variant = pack_product.selected_or_first_available_variant
  assign unit_cents = variant.price | default: 0
  assign duo_cents = unit_cents | times: 175 | divided_by: 100 | plus: 25 | divided_by: 50 | times: 50
  assign trio_cents = unit_cents | times: 270 | divided_by: 100 | plus: 50 | divided_by: 100 | times: 100
  assign pack_id = pack_product.id
-%}

<rc-pack-picker
  class="rc-pack-picker"
  data-product-id="{{ pack_id }}"
  data-unit-price="{{ unit_cents }}"
>
  <script type="application/json" data-rc-pack-variants>
    {
      {%- for pack_variant in pack_product.variants -%}
        "{{ pack_variant.id }}": {{ pack_variant.price }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>

  <fieldset class="rc-pack-picker__fieldset">
    <legend class="rc-pack-picker__legend">Combien pour votre entourage ?</legend>

    <label class="rc-pack-picker__card is-selected">
      <input
        class="rc-pack-picker__radio"
        type="radio"
        name="rc-pack-{{ pack_id }}"
        value="1"
        checked
      >
      <span class="rc-pack-picker__radio-ui" aria-hidden="true"></span>
      <span class="rc-pack-picker__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 15.5h16l-1.4-5.2A2 2 0 0 0 16.7 9H7.3a2 2 0 0 0-1.9 1.3L4 15.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
          <path d="M7 9V7.8A1.8 1.8 0 0 1 8.8 6h6.4A1.8 1.8 0 0 1 17 7.8V9" stroke="currentColor" stroke-width="1.6"/>
          <circle cx="7.5" cy="16.8" r="1.4" stroke="currentColor" stroke-width="1.6"/>
          <circle cx="16.5" cy="16.8" r="1.4" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </span>
      <span class="rc-pack-picker__copy">
        <span class="rc-pack-picker__title">1 véhicule RC</span>
      </span>
      <span class="rc-pack-picker__price" data-rc-pack-price="1">{{ unit_cents | money }}</span>
    </label>

    <label class="rc-pack-picker__card">
      <input
        class="rc-pack-picker__radio"
        type="radio"
        name="rc-pack-{{ pack_id }}"
        value="2"
      >
      <span class="rc-pack-picker__radio-ui" aria-hidden="true"></span>
      <span class="rc-pack-picker__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M3.5 16h8.8l-.8-3.2A1.4 1.4 0 0 0 10.1 12H5.2a1.4 1.4 0 0 0-1.3.8L3.5 16Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="5.6" cy="16.8" r="1.1" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="10.6" cy="16.8" r="1.1" stroke="currentColor" stroke-width="1.5"/>
          <path d="M11.8 13.8h8.7l-.8-3.2A1.4 1.4 0 0 0 18.4 9.8h-4.9a1.4 1.4 0 0 0-1.3.8l-.4 1.4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="14" cy="14.6" r="1.1" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="19" cy="14.6" r="1.1" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <span class="rc-pack-picker__copy">
        <span class="rc-pack-picker__title">Pack duo | 2 véhicules RC</span>
      </span>
      <span class="rc-pack-picker__price is-duo" data-rc-pack-price="2">{{ duo_cents | money }}</span>
    </label>

    <label class="rc-pack-picker__card">
      <input
        class="rc-pack-picker__radio"
        type="radio"
        name="rc-pack-{{ pack_id }}"
        value="3"
      >
      <span class="rc-pack-picker__radio-ui" aria-hidden="true"></span>
      <span class="rc-pack-picker__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M4 16.2h16M6 16.2c0 .9-.7 1.6-1.6 1.6S2.8 17.1 2.8 16.2 3.5 14.6 4.4 14.6 6 15.3 6 16.2ZM21.2 16.2c0 .9-.7 1.6-1.6 1.6s-1.6-.7-1.6-1.6.7-1.6 1.6-1.6 1.6.7 1.6 1.6Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          <path d="M4.2 16.2 5.6 10.8A1.6 1.6 0 0 1 7.1 9.6h9.8a1.6 1.6 0 0 1 1.5 1.2l1.4 5.4" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M8 9.6V8.2A1.6 1.6 0 0 1 9.6 6.6h4.8A1.6 1.6 0 0 1 16 8.2v1.4" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </span>
      <span class="rc-pack-picker__copy">
        <span class="rc-pack-picker__title">Pack trio | 3 véhicules RC</span>
      </span>
      <span class="rc-pack-picker__price is-trio" data-rc-pack-price="3">{{ trio_cents | money }}</span>
    </label>
  </fieldset>
</rc-pack-picker>

<script src="{{ 'rc-pack-picker.js' | asset_url }}" type="module"></script>
