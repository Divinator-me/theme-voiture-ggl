{%- liquid
  assign pack_product = product | default: closest.product
  assign variant = pack_product.selected_or_first_available_variant
  assign unit_cents = variant.price | default: 0
  assign duo_cents = unit_cents | times: 18 | plus: 5 | divided_by: 10
  assign trio_cents = unit_cents | times: 24 | plus: 5 | divided_by: 10
  assign pack_id = pack_product.id
  assign trio_gift = all_products['batterie-offerte-produit-rc-lab']
  assign trio_gift_variant = trio_gift.selected_or_first_available_variant
  assign extra_battery = all_products['batterie-supplementaire-produit-rc-lab']
  assign extra_battery_variant = extra_battery.selected_or_first_available_variant
  assign accessory_handles = 'batterie-supplementaire-produit-rc-lab,chargeur-secteur-haute-capacite-rc-lab,batterie-offerte-produit-rc-lab' | split: ','
  assign solo_batteries = 2
  assign duo_batteries = 4
  assign trio_batteries = 7
  assign pack_standard_label = 'pack standard - 2 batteries offertes'
  assign pack_duo_label = 'pack duo - 4 batteries'
  assign pack_trio_label = 'pack trio - 7 batteries'
  if pack_product.handle == '4x4-brushless-1-16-85-km-h'
    assign solo_batteries = 3
    assign duo_batteries = 6
    assign trio_batteries = 9
    assign pack_standard_label = 'pack standard - 3 batteries offertes'
    assign pack_duo_label = 'pack duo - 6 batteries offertes'
    assign pack_trio_label = 'pack trio - 9 batteries offertes'
  endif
-%}

{%- unless accessory_handles contains pack_product.handle -%}
<rc-pack-picker
  class="rc-pack-picker"
  data-product-id="{{ pack_id }}"
  data-unit-price="{{ unit_cents }}"
  data-compare-price="{{ variant.compare_at_price | default: 0 }}"
  data-rc-pack-labels="{{ pack_standard_label }}|{{ pack_duo_label }}|{{ pack_trio_label }}"
  data-rc-gift-batteries="{{ solo_batteries }},{{ duo_batteries }},{{ trio_batteries }}"
  {% if trio_gift_variant %}data-gift-battery-variant-id="{{ trio_gift_variant.id }}" data-trio-gift-variant-id="{{ trio_gift_variant.id }}"{% endif %}
  {% if extra_battery_variant %}data-extra-battery-variant-id="{{ extra_battery_variant.id }}"{% endif %}
>
  <script type="application/json" data-rc-pack-compares>
    {
      {%- for pack_variant in pack_product.variants -%}
        "{{ pack_variant.id }}": {{ pack_variant.compare_at_price | default: 0 }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
  <script type="application/json" data-rc-pack-variants>
    {
      {%- for pack_variant in pack_product.variants -%}
        "{{ pack_variant.id }}": {{ pack_variant.price }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
  <script type="application/json" data-rc-pack-variant-map>
    [
      {%- for pack_variant in pack_product.variants -%}
        {"id":{{ pack_variant.id }},"available":{{ pack_variant.available }},"options":{{ pack_variant.options | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>

  <fieldset class="rc-pack-picker__fieldset">
    <legend class="rc-pack-picker__legend">Combien pour votre entourage ?</legend>

    <div class="rc-pack-picker__options">
    <label class="rc-pack-picker__card is-solo">
      <input
        class="rc-pack-picker__radio"
        type="radio"
        name="rc-pack-{{ pack_id }}"
        value="1"
      >
      <span class="rc-pack-picker__radio-ui" aria-hidden="true"></span>
      <span class="rc-pack-picker__icon" aria-hidden="true">🚗</span>
      <span class="rc-pack-picker__copy">
        <span class="rc-pack-picker__title">1 véhicule</span>
        <span class="rc-pack-picker__perk">+ {{ solo_batteries }} batteries<br>offertes</span>
      </span>
      <span class="rc-pack-picker__price" data-rc-pack-price="1">{{ unit_cents | money }}</span>
    </label>

    <label class="rc-pack-picker__card is-duo">
      <input
        class="rc-pack-picker__radio"
        type="radio"
        name="rc-pack-{{ pack_id }}"
        value="2"
      >
      <span class="rc-pack-picker__radio-ui" aria-hidden="true"></span>
      <span class="rc-pack-picker__icon" aria-hidden="true">⭐</span>
      <span class="rc-pack-picker__copy">
        <span class="rc-pack-picker__title">Pack duo</span>
        <span class="rc-pack-picker__perk">+ {{ duo_batteries }} batteries<br>offertes</span>
      </span>
      <span class="rc-pack-picker__price is-duo" data-rc-pack-price="2">{{ duo_cents | money }}</span>
    </label>

    <label class="rc-pack-picker__card is-trio">
      <input
        class="rc-pack-picker__radio"
        type="radio"
        name="rc-pack-{{ pack_id }}"
        value="3"
      >
      <span class="rc-pack-picker__radio-ui" aria-hidden="true"></span>
      <span class="rc-pack-picker__icon" aria-hidden="true">🏆</span>
      <span class="rc-pack-picker__copy">
        <span class="rc-pack-picker__title">Pack trio</span>
        <span class="rc-pack-picker__perk">+ {{ trio_batteries }} batteries<br>offertes</span>
      </span>
      <span class="rc-pack-picker__price is-trio" data-rc-pack-price="3">{{ trio_cents | money }}</span>
    </label>
    </div>
    <div class="rc-pack-picker__badges">
      <span></span>
      <span class="rc-pack-picker__badge" data-rc-pack-badge="2">-10 %</span>
      <span class="rc-pack-picker__badge" data-rc-pack-badge="3">-20 %</span>
    </div>
  </fieldset>
</rc-pack-picker>

<script src="{{ 'rc-pack-picker.js' | asset_url }}" type="module"></script>
{%- endunless -%}
