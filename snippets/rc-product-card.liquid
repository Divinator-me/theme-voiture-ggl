{%- doc -%}
  Carte produit RC — design partagé (landing, collections, recommandations).
{%- enddoc -%}

{% liquid
  assign rating_value = product.metafields.reviews.rating.value.rating
  assign rating_count = product.metafields.reviews.rating_count
  assign color_option = null
  assign on_sale = false
  assign card_variant = product.selected_or_first_available_variant

  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'couleur' or option_name contains 'color' or option_name contains 'colour'
      assign color_option = option
      break
    endif
  endfor
%}

<article class="rc-product-card rc-product-card--live">
  <div class="rc-product-card__media">
    <div class="rc-product-card__image-wrap">
      {% if on_sale %}
        <span class="rc-product-card__badge">Promo</span>
      {% endif %}

      <a class="rc-product-card__image{% if product.images.size > 1 %} rc-product-card__image--dual{% endif %}" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
        {% if product.featured_image %}
          <span class="rc-product-card__image-layer rc-product-card__image-layer--primary">
            {{
              product.featured_image
              | image_url: width: 700
              | image_tag:
                loading: 'lazy',
                widths: '320, 480, 700',
                sizes: '(min-width: 990px) 28vw, 72vw',
                alt: product.title,
                class: 'rc-product-card__photo',
                draggable: 'false'
            }}
          </span>

          {% if product.images.size > 1 %}
            <span class="rc-product-card__image-layer rc-product-card__image-layer--hover" aria-hidden="true">
              {{
                product.images[1]
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  widths: '320, 480, 700',
                  sizes: '(min-width: 990px) 28vw, 72vw',
                  alt: '',
                  class: 'rc-product-card__photo',
                  draggable: 'false'
              }}
            </span>
          {% endif %}
        {% else %}
          <svg viewBox="0 0 260 260" aria-hidden="true">
            <rect width="260" height="260" rx="18" fill="#F4F4F4"/>
            <path d="M54 158c8-31 32-49 72-55l59-8c23-3 44 10 53 31l12 32h-41c-7-17-23-28-42-28s-35 11-42 28H96c-7-17-23-28-42-28-18 0-34 11-41 28h41Z" fill="#0A0A0A"/>
            <circle cx="74" cy="171" r="26" fill="#FF2D2D"/>
            <circle cx="176" cy="171" r="26" fill="#FF2D2D"/>
          </svg>
        {% endif %}
      </a>
    </div>
  </div>

  <div class="rc-product-card__body">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>

    {% if color_option != null and color_option.values.size > 0 %}
      <ul class="rc-product-card__colors" aria-label="Couleurs disponibles">
        {% for value in color_option.values %}
          <li>
            {% render 'rc-color-swatch', product: product, color_option: color_option, value: value %}
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <p class="rc-product-card__price">
      {% if on_sale %}
        <span class="rc-product-card__price-compare">{{ product.compare_at_price | money }}</span>
      {% endif %}
      <span class="rc-product-card__price-current">{{ product.price | money }}</span>
    </p>

    <div class="rc-product-card__rating" aria-label="Note produit">
      <span class="rc-product-card__stars" aria-hidden="true">
        {% for star in (1..5) %}
          <span class="rc-product-card__star is-filled">★</span>
        {% endfor %}
      </span>
      <span class="rc-product-card__reviews">
        {% if rating_value != blank %}
          {{ rating_value }}
        {% else %}
          5.0
        {% endif %}
        {% if rating_count != blank and rating_count > 0 %}
          ({{ rating_count }})
        {% else %}
          (1)
        {% endif %}
      </span>
    </div>

    <div class="rc-product-card__footer">
      <button
        type="button"
        class="rc-product-card__cta"
        data-product-id="{{ product.id }}"
        data-variant-id="{{ card_variant.id }}"
        aria-label="Ajouter au panier"
        {% unless card_variant.available %}
          disabled
        {% endunless %}
      >
        <span class="rc-product-card__cta-text" data-label-default>Ajouter au panier</span>
        <span class="rc-product-card__cta-text" data-label-in-cart hidden>Voir le panier</span>
      </button>
    </div>
  </div>
</article>
