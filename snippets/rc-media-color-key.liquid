{%- doc -%}
  Couleur d'une media produit, ou vide si l'image est commune a toutes les couleurs.
  Sources : image de variante, nom de fichier, texte alternatif.
{%- enddoc -%}

{%- liquid
  assign matched = ''

  for variant in product.variants
    if variant.featured_media.id == media.id
      for sel in variant.selected_options
        assign option_name = sel.name | downcase
        if option_name == 'couleur' or option_name == 'color' or option_name == 'colour' or option_name contains 'couleur'
          assign matched = sel.value
          break
        endif
      endfor
    endif
    if matched != blank
      break
    endif
  endfor

  if matched == blank
    assign src = media.preview_image.src | default: '' | split: '?' | first
    assign filename = src | split: '/' | last | downcase
    assign alt_text = media.alt | default: media.preview_image.alt | default: '' | downcase
    assign title_down = product.title | downcase
    if alt_text == title_down
      assign alt_text = ''
    endif
    assign haystack = filename | append: ' ' | append: alt_text | replace: '-', ' ' | replace: '_', ' ' | replace: '.', ' '
    assign haystack = ' ' | append: haystack | append: ' '

    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name == 'couleur' or option_name == 'color' or option_name == 'colour' or option_name contains 'couleur'
        for value in option.values
          assign color_name = value.name | default: value
          assign color_down = color_name | downcase | strip
          assign stem = color_down | split: ' ' | first
          assign alias_list = stem

          case stem
            when 'noir', 'black'
              assign alias_list = 'noir|black'
            when 'bleu', 'blue'
              assign alias_list = 'bleu|blue'
            when 'vert', 'green'
              assign alias_list = 'vert|green'
            when 'blanc', 'white'
              assign alias_list = 'blanc|white'
            when 'rouge', 'red'
              assign alias_list = 'rouge|red'
            when 'jaune', 'yellow'
              assign alias_list = 'jaune|yellow'
            when 'gris', 'grey', 'gray'
              assign alias_list = 'gris|grey|gray'
            when 'rose', 'pink'
              assign alias_list = 'rose|pink'
            when 'violet', 'purple'
              assign alias_list = 'violet|purple'
          endcase

          assign needles = alias_list | split: '|'
          for needle in needles
            assign padded = ' ' | append: needle | append: ' '
            if haystack contains padded
              assign matched = color_name
              break
            endif
          endfor
          if matched != blank
            break
          endif
        endfor
      endif
      if matched != blank
        break
      endif
    endfor
  endif
-%}
{{- matched | downcase | strip -}}
