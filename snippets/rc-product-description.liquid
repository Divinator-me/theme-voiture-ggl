{% liquid
  assign description_product = product
  if description_product == blank
    assign description_product = closest.product
  endif

  assign mf = description_product.metafields.rc

  assign has_metafield_content = false
  if mf.tout_savoir != blank or mf.caracteristiques != blank or mf.livraison_retours != blank or mf.fabrication_rigoureuse != blank
    assign has_metafield_content = true
  endif

  assign show_component = false
  if has_metafield_content or description_product.description != blank or default_livraison != blank or default_fabrication != blank or default_garantie != blank
    assign show_component = true
  endif

  assign desc_handle = description_product.handle | default: ''
  assign desc_video_src = ''
  assign desc_video_poster = ''
  if desc_handle == 'conquer-4x4-1-16-voiture-telecommandee-tout-terrain-50-km-h' or desc_handle == '4x4-tout-terrain-1-16-50-km-h'
    assign desc_video_src = 'https://cdn.shopify.com/videos/c/o/v/3cd2217cea954b88babc96b61c502a13.mp4'
    assign desc_video_poster = 'rc-desc-conquer-poster.jpg'
  endif
  assign video_ok = false
  assign video_ok_handles = 'volkswagen-polo-r-wrc-1-14-voiture-telecommandee-de-rallye-et-drift,voiture-telecommandee-buggy-off-road-4x4-1-16,trophy-truck-rc-1-16-voiture-telecommandee-4x4-50-km-h,monster-truck-rc-1-16-4wd-45-km-h-tout-terrain-brushed,force-13-1-12-buggy-telecommande-4x4-haute-vitesse-75-km-h,buggy-mantis-voiture-telecommandee-1-16-4wd,buggy-4x4-1-14-brushless-70-km-h,buggy-4x4-1-14-brushless-75-km-h-v2,trophy-truck-rc-1-16-brushless-voiture-telecommandee-4x4-70-km-h,sweep-pro-4x4-voiture-telecommandee-tout-terrain-70-km-h,sweep-pro-4x4-70-kmh-rclab,rapidly-4x4-1-16-voiture-telecommandee-tout-terrain-50-km-h,nissan-gt-r-r35-1-24-voiture-telecommandee-drift-et-piste-30-km-h,lancia-delta-martini-racing-1-14-voiture-telecommandee-de-rallye-et-drift,ford-mustang-gt-1-24-voiture-telecommandee-drift-et-piste-30-km-h,crawler-4x4-telecommande-tout-terrain-replique-jeep-wrangler,buggy-rc-match-1-10-voiture-telecommandee-4x4' | split: ','
  for video_ok_handle in video_ok_handles
    if desc_handle == video_ok_handle
      assign video_ok = true
      break
    endif
  endfor
%}

{% if show_component %}
  {% capture tout_savoir_html %}
    {% if mf.tout_savoir != blank %}
      {{ mf.tout_savoir | metafield_tag }}
    {% endif %}
  {% endcapture %}

  {% capture caracteristiques_html %}
    {% if mf.caracteristiques != blank %}
      {{ mf.caracteristiques | metafield_tag }}
    {% endif %}
  {% endcapture %}

  {% capture livraison_html %}
    {% if mf.livraison_retours != blank %}
      {{ mf.livraison_retours | metafield_tag }}
    {% else %}
      {{ default_livraison }}
    {% endif %}
  {% endcapture %}

  {% capture fabrication_html %}
    {% if mf.fabrication_rigoureuse != blank %}
      {{ mf.fabrication_rigoureuse | metafield_tag }}
    {% else %}
      {{ default_fabrication }}
    {% endif %}
  {% endcapture %}

  {% capture garantie_html %}
    {{ default_garantie }}
  {% endcapture %}

  <div
    class="rc-product-desc"
    data-rc-product-desc
    {% if video_ok %}
      data-rc-keep-video
    {% endif %}
    {% if has_metafield_content %}
      data-rc-product-desc-mode="metafields"
    {% endif %}
  >
    {% if description_product.description != blank %}
      <div class="rc-product-desc__source rte" hidden data-rc-product-desc-source>
        {{ description_product.description }}
      </div>
    {% endif %}

    <script type="application/json" data-rc-product-sections>
      {
        "tout_savoir": {{ tout_savoir_html | strip | json }},
        "caracteristiques": {{ caracteristiques_html | strip | json }},
        "livraison_retours": {{ livraison_html | strip | json }},
        "fabrication_rigoureuse": {{ fabrication_html | strip | json }},
        "garantie_2_ans": {{ garantie_html | strip | json }}
      }
    </script>

    {% if desc_video_src != blank %}
      <script type="application/json" data-rc-desc-video>
        {"src":{{ desc_video_src | json }},"poster":{{ desc_video_poster | asset_url | json }}}
      </script>
    {% endif %}

    {% render 'rc-product-snapshot', product: description_product %}
    {% render 'rc-product-repair', product: description_product %}
  </div>
{% endif %}
