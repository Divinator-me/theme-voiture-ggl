<!doctype html>
{%- liquid
  assign rc_redirect_frontpage_collection = false
  if template.name == 'collection' and collection.handle == 'frontpage' and request.design_mode == false
    assign rc_redirect_frontpage_collection = true
  endif

  assign rc_legal_page_redirect = ''
  assign rc_cgv_policy_url = '/policies/terms-of-sale'
  for shop_policy in shop.policies
    if shop_policy.url contains 'terms-of-sale'
      assign rc_cgv_policy_url = shop_policy.url
      break
    endif
  endfor

  if request.design_mode == false
    case request.path
      when '/pages/retours-remboursements'
        assign rc_legal_page_redirect = shop.refund_policy.url | default: '/policies/refund-policy'
      when '/pages/politique-de-livraison'
        assign rc_legal_page_redirect = shop.shipping_policy.url | default: '/policies/shipping-policy'
      when '/pages/confidentialite'
        assign rc_legal_page_redirect = shop.privacy_policy.url | default: '/policies/privacy-policy'
      when '/pages/mentions-legales', '/pages/mention-legale'
        assign rc_legal_page_redirect = '/policies/legal-notice'
      when '/pages/cgv', '/pages/conditions-generales-de-vente', '/pages/conditions-de-vente'
        assign rc_legal_page_redirect = rc_cgv_policy_url
      when '/policies/terms-of-service'
        assign rc_legal_page_redirect = rc_cgv_policy_url
      when '/pages/faq-boutique'
        assign rc_legal_page_redirect = routes.root_url | append: '#faq'
      when '/pages/qui-sommes-nous'
        if pages['a-propos'] != blank
          assign rc_legal_page_redirect = pages['a-propos'].url
        endif
    endcase
  endif

  assign rc_redirect_url = ''
  if rc_redirect_frontpage_collection
    assign rc_redirect_url = routes.root_url
  elsif rc_legal_page_redirect != blank
    assign rc_redirect_url = rc_legal_page_redirect
  endif
-%}
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    {% if settings.transition_to_main_product or settings.page_transition_enabled %}
      <link
        rel="expect"
        href="#MainContent"
        blocking="render"
        id="view-transition-render-blocker"
      >
    {% endif %}

    {%- render 'meta-tags' -%}
    <meta name="google-site-verification" content="pskfJiRxMrbi6G3zY9AI6Up0jictfr8H2EMGf_eWVjg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    >
    {{ 'design-tokens.css' | asset_url | stylesheet_tag }}
    {%- render 'stylesheets' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {%- if rc_redirect_url != blank -%}
      <meta http-equiv="refresh" content="0;url={{ rc_redirect_url }}">
      <meta name="robots" content="noindex, follow">
      <link rel="canonical" href="{{ shop.url }}{{ rc_redirect_url }}">
    {%- endif -%}
  </head>

  <body class="template-{{ template.name }} page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="rc-header-group">
        {% sections 'rc-header-group' %}
      </div>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {%- if rc_redirect_url != blank -%}
          <script>window.location.replace({{ rc_redirect_url | json }});</script>
        {%- elsif request.page_type == 'policy' -%}
          {% section 'policy-legal-rc' %}
        {%- else -%}
          {{ content_for_layout }}
        {%- endif -%}
      </main>

      <footer id="rc-footer-group">
        {% sections 'rc-footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% render 'rc-quiz-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
  </body>
</html>
